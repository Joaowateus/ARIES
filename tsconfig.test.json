{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "paths": {
      "@soe/core-config": ["./packages/core/config/src/index.ts"],
      "@soe/core-logger": ["./packages/core/logger/src/index.ts"],
      "@soe/core-errors": ["./packages/core/errors/src/index.ts"],
      "@soe/core-time": ["./packages/core/time/src/index.ts"],
      "@soe/core-identity": ["./packages/core/identity/src/index.ts"],
      "@soe/core-validation": ["./packages/core/validation/src/index.ts"],
      "@soe/core-events": ["./packages/core/events/src/index.ts"],
      "@soe/core-audit": ["./packages/core/audit/src/index.ts"],
      "@soe/core-health": ["./packages/core/health/src/index.ts"],
      "@soe/core-observability": ["./packages/core/observability/src/index.ts"],
      "@soe/cap-01": ["./packages/cap-01/src/index.ts"],
      "@soe/cap-01/*": ["./packages/cap-01/src/*"],
      "@soe/cap-02": ["./packages/cap-02/src/index.ts"],
      "@soe/cap-02/*": ["./packages/cap-02/src/*"],
      "@soe/cap-03": ["./packages/cap-03/src/index.ts"],
      "@soe/cap-03/*": ["./packages/cap-03/src/*"],
      "@soe/cap-04": ["./packages/cap-04/src/index.ts"],
      "@soe/cap-04/*": ["./packages/cap-04/src/*"],
      "@soe/cap-05": ["./packages/cap-05/src/index.ts"],
      "@soe/cap-05/*": ["./packages/cap-05/src/*"],
      "@soe/cap-06": ["./packages/cap-06/src/index.ts"],
      "@soe/cap-06/*": ["./packages/cap-06/src/*"],
      "@soe/cap-07": ["./packages/cap-07/src/index.ts"],
      "@soe/cap-07/*": ["./packages/cap-07/src/*"],
      "@soe/cap-08": ["./packages/cap-08/src/index.ts"],
      "@soe/cap-08/*": ["./packages/cap-08/src/*"],
      "@soe/cap-09": ["./packages/cap-09/src/index.ts"],
      "@soe/cap-09/*": ["./packages/cap-09/src/*"],
      "@soe/implantacao": ["./packages/implantacao/src/index.ts"],
      "@soe/implantacao/*": ["./packages/implantacao/src/*"],
      "@soe/dashboards": ["./packages/dashboards/src/index.ts"],
      "@soe/dashboards/*": ["./packages/dashboards/src/*"],
      "@soe/administracao": ["./packages/administracao/src/index.ts"],
      "@soe/administracao/*": ["./packages/administracao/src/*"],
      "@soe/configuracao": ["./packages/configuracao/src/index.ts"],
      "@soe/configuracao/*": ["./packages/configuracao/src/*"]
    }
  },
  "include": [
    "packages/core/*/src/**/*",
    "packages/core/*/tests/**/*",
    "packages/cap-01/src/**/*",
    "packages/cap-01/tests/**/*",
    "packages/cap-02/src/**/*",
    "packages/cap-02/tests/**/*",
    "packages/cap-03/src/**/*",
    "packages/cap-03/tests/**/*",
    "packages/cap-04/src/**/*",
    "packages/cap-04/tests/**/*",
    "packages/cap-05/src/**/*",
    "packages/cap-05/tests/**/*",
    "packages/cap-06/src/**/*",
    "packages/cap-06/tests/**/*",
    "packages/cap-07/src/**/*",
    "packages/cap-08/src/**/*",
    "packages/cap-09/src/**/*",
    "packages/implantacao/src/**/*",
    "packages/dashboards/src/**/*",
    "packages/administracao/src/**/*",
    "packages/configuracao/src/**/*",
    "tests/**/*"
  ]
}
