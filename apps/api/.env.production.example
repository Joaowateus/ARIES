# Copiar para .env no servidor de produção e preencher os valores reais

# Banco PostgreSQL (Neon, Supabase, Railway PostgreSQL, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/aries?sslmode=require"

# JWT — gerar com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="GERAR_NOVO_SECRET_64_BYTES_HEX"

# Porta da API (Railway define automaticamente via $PORT)
PORT=3001

# Ambiente
NODE_ENV=production

# URL do frontend em produção (sem barra no final)
FRONTEND_URL=https://app.ariesnegocios.com.br

# Log level em produção
LOG_LEVEL=info
