generator client {
  provider      = "prisma-client-js"
  // "native" continua servindo o ambiente local; rhel-openssl-3.0.x é o
  // runtime das funções serverless da Vercel — sem isso o Prisma não acha
  // o binário certo do query engine em produção lá.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Empresa {
  id           String   @id @default(cuid())
  nome         String
  cnpj         String?  @unique
  segmento     String   @default("motos")
  criadaEm     DateTime @default(now())
  atualizadaEm DateTime @updatedAt

  usuarios               Usuario[]
  unidades               Unidade[]
  metas                  Meta[]
  oportunidades          Oportunidade[]
  contratos              Contrato[]
  contasReceber          ContaReceber[]
  parametroPrecificacao  ParametroPrecificacao?
  historicoPrecificacao  HistoricoPrecificacao[]
  protocolos             Protocolo[]
  estagioHistorico       EstagioHistorico[]
  atividadesOportunidade AtividadeOportunidade[]
  metasFunilEtapa        MetaFunilEtapa[]
  contasAnuncio          ContaAnuncio[]
  anunciosProducao       AnuncioProducao[]
  conteudosSocialMedia   ConteudoSocialMedia[]
  rotinas                Rotina[]
  rotinaExecucoes        RotinaExecucao[]
  tarefas                Tarefa[]
  processos              Processo[]
  treinamentos           Treinamento[]
  treinamentoProgresso   TreinamentoProgresso[]
  auditorias             Auditoria[]
  planosAcao             PlanoAcao[]
  notificacoes           Notificacao[]
  scoreConfig            ScoreConfig?
  logAuditoria           LogAuditoria[]
  metaComercialPadrao    MetaComercialPadrao?
  leadsRegistrados       LeadRegistrado[]
  custoLeadConfig        CustoLeadConfig?

  @@map("empresas")
}

model Usuario {
  id           String   @id @default(cuid())
  empresaId    String
  nome         String
  email        String   @unique
  senhaHash    String
  papel        String   @default("VENDEDOR")
  status       String   @default("ATIVO")
  departamento String?
  gestorId     String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  empresa             Empresa                 @relation(fields: [empresaId], references: [id])
  gestor              Usuario?                @relation("Hierarquia", fields: [gestorId], references: [id])
  subordinados        Usuario[]               @relation("Hierarquia")
  oportunidades       Oportunidade[]
  contratos           Contrato[]
  historicoSolicitado HistoricoPrecificacao[] @relation("HistoricoSolicitante")
  historicoAprovado   HistoricoPrecificacao[] @relation("HistoricoAprovador")
  protocolosCriados   Protocolo[]
  auditoriasProtocolo AuditoriaProtocolo[]
  planosAcaoProtocolo PlanoAcaoProtocolo[]
  metas               Meta[]
  atividades          AtividadeOportunidade[]
  rotinaExecucoes     RotinaExecucao[]
  tarefas             Tarefa[]                @relation("TarefaResponsavel")
  tarefasCriadas      Tarefa[]                @relation("TarefaCriador")
  anuncios            AnuncioProducao[]
  contasAnuncio       ContaAnuncio[]
  conteudos           ConteudoSocialMedia[]
  treinamentos        TreinamentoProgresso[]
  notificacoes        Notificacao[]
  auditorias          Auditoria[]
  planosAcao          PlanoAcao[]
  leadsRegistrados    LeadRegistrado[]

  @@index([empresaId])
  @@index([empresaId, status])
  @@index([gestorId])
  @@map("usuarios")
}

// Unidade = moto específica em estoque (com chassi, placa, etc.)
model Unidade {
  id           String   @id @default(cuid())
  empresaId    String
  nome         String // ex: "Honda CG 160 Titan 2024 Vermelha"
  categoria    String   @default("MOTO")
  marca        String?
  modelo       String?
  ano          Int?
  cor          String?
  chassi       String?  @unique
  placa        String?
  km           Int?     @default(0)
  precoBase    Float?
  situacao     String   @default("DISPONIVEL") // DISPONIVEL | RESERVADA | VENDIDA | INATIVO
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  // --- Engenharia de Precificação (CAP-06 especializado — ver
  // docs/05-modules/commercial/cap-06-oferta-e-precificacao/ENGENHARIA-PRECIFICACAO-MOTOS-MM.md) ---
  dataCompra         DateTime? // entrada no estoque — base do cálculo de dias em estoque
  valorCompra        Float? // Pilar 1/8: preço pago pela moto (Custo Base)
  custoRevisao       Float?    @default(0)
  custoEstetica      Float?    @default(0)
  custoDocumentacao  Float?    @default(0)
  custoFrete         Float?    @default(0)
  custoCombustivel   Float?    @default(0)
  custoAcessorios    Float?    @default(0)
  custoOutros        Float?    @default(0)
  marketingInvestido Float?    @default(0) // Pilar 8.6 — verba real investida nesta moto

  empresa               Empresa                 @relation(fields: [empresaId], references: [id])
  oportunidades         Oportunidade[]
  contratos             Contrato[]
  historicoPrecificacao HistoricoPrecificacao[]
  anuncios              AnuncioProducao[]

  @@index([empresaId])
  @@index([empresaId, situacao])
  @@map("unidades")
}

model Meta {
  id        String   @id @default(cuid())
  empresaId String
  usuarioId String? // null = meta da empresa/departamento; setado = meta individual do colaborador
  titulo    String
  tipo      String   @default("QUANTIDADE")
  valor     Float
  periodo   String
  inicioEm  DateTime
  fimEm     DateTime
  status    String   @default("ATIVA")
  criadaEm  DateTime @default(now())

  empresa Empresa  @relation(fields: [empresaId], references: [id])
  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([empresaId, usuarioId])
  @@map("metas")
}

// Padrão comercial único da empresa, aplicado a qualquer vendedor (supermeta
// de vendas + meta de anúncios orgânicos) — mesmo padrão de "config de linha
// única por empresa, com default, editável por gestão" do ParametroPrecificacao.
model MetaComercialPadrao {
  id                      String   @id @default(cuid())
  empresaId               String   @unique
  supermetaVendasMes      Int      @default(10)
  supermetaFaturamentoMes Float    @default(150000) // base pro painel de produção — trimestre/ano derivam daqui (×3 / ×12)
  metaAnunciosMes         Int      @default(2000)
  atualizadoEm            DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@map("metas_comerciais_padrao")
}

model Oportunidade {
  id                   String    @id @default(cuid())
  empresaId            String
  responsavelId        String?
  unidadeId            String?
  nomeCliente          String
  telefone             String?
  email                String?
  estagio              String    @default("NOVO_LEAD")
  origem               String    @default("MANUAL")
  tipoLead             String? // TRAFEGO | ORGANICO — pra separar produção de lead pago vs orgânico no Funil
  valor                Float?
  observacoes          String?
  ultimaInteracaoEm    DateTime?
  proximaAcaoEm        DateTime?
  proximaAcaoDescricao String?
  criadaEm             DateTime  @default(now())
  atualizadaEm         DateTime  @updatedAt
  fechadaEm            DateTime?
  statusFinal          String?

  empresa          Empresa                 @relation(fields: [empresaId], references: [id])
  responsavel      Usuario?                @relation(fields: [responsavelId], references: [id])
  unidade          Unidade?                @relation(fields: [unidadeId], references: [id])
  contrato         Contrato?
  historicoEstagio EstagioHistorico[]
  atividades       AtividadeOportunidade[]

  @@index([empresaId])
  @@index([empresaId, estagio])
  @@index([empresaId, responsavelId])
  @@index([empresaId, proximaAcaoEm])
  @@map("oportunidades")
}

// Log de interação/follow-up (ligação, WhatsApp, visita, simulação...) — distinto
// do EstagioHistorico, que só registra troca de etapa do funil.
model AtividadeOportunidade {
  id             String   @id @default(cuid())
  empresaId      String
  oportunidadeId String
  usuarioId      String
  tipo           String // LIGACAO | WHATSAPP | VISITA | SIMULACAO | EMAIL | OUTRO
  descricao      String
  criadoEm       DateTime @default(now())

  empresa      Empresa      @relation(fields: [empresaId], references: [id])
  oportunidade Oportunidade @relation(fields: [oportunidadeId], references: [id])
  usuario      Usuario      @relation(fields: [usuarioId], references: [id])

  @@index([empresaId])
  @@index([oportunidadeId])
  @@map("atividades_oportunidade")
}

// Trilha de transição de estágio — base para "tempo médio por etapa" e conversão
// etapa-a-etapa do funil (Dashboard Executivo). Cada mudança de estágio grava um
// registro; sem isso não dá pra medir velocidade do funil de forma honesta.
model EstagioHistorico {
  id              String   @id @default(cuid())
  empresaId       String
  oportunidadeId  String
  estagioAnterior String?
  estagioNovo     String
  criadoEm        DateTime @default(now())

  empresa      Empresa      @relation(fields: [empresaId], references: [id])
  oportunidade Oportunidade @relation(fields: [oportunidadeId], references: [id])

  @@index([empresaId])
  @@index([oportunidadeId])
  @@map("estagio_historico")
}

// Contador permanente de leads registrados — uma linha por lead criado, pra
// sempre. Ao contrário de Oportunidade/EstagioHistorico (que somem se o card
// for apagado no CRM), este registro nunca é apagado: é a fonte do "total de
// Leads" que o Funil de Vendas usa como base de 100%, pra não encolher
// silenciosamente quando alguém limpa o board.
model LeadRegistrado {
  id        String   @id @default(cuid())
  empresaId String
  usuarioId String
  tipoLead  String? // TRAFEGO | ORGANICO — espelha Oportunidade.tipoLead, pro contador permanente
  criadoEm  DateTime @default(now())

  empresa Empresa @relation(fields: [empresaId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([empresaId])
  @@index([empresaId, usuarioId])
  @@index([empresaId, criadoEm])
  @@map("leads_registrados")
}

model Contrato {
  id                           String   @id @default(cuid())
  empresaId                    String
  oportunidadeId               String   @unique
  unidadeId                    String?
  vendedorId                   String?
  nomeCliente                  String
  cpfCliente                   String?
  telefoneCliente              String?
  valorTotal                   Float
  entrada                      Float?   @default(0)
  parcelas                     Int?     @default(1)
  observacoes                  String?
  status                       String   @default("ATIVO") // ATIVO | CANCELADO | ENCERRADO
  processoAdministrativoStatus String   @default("PENDENTE") // PENDENTE | CONCLUIDO — etapa final do funil (transferência/documentação), meta 100% sem erro
  criadoEm                     DateTime @default(now())
  atualizadoEm                 DateTime @updatedAt

  empresa       Empresa        @relation(fields: [empresaId], references: [id])
  oportunidade  Oportunidade   @relation(fields: [oportunidadeId], references: [id])
  unidade       Unidade?       @relation(fields: [unidadeId], references: [id])
  vendedor      Usuario?       @relation(fields: [vendedorId], references: [id])
  contasReceber ContaReceber[]

  @@index([empresaId])
  @@index([empresaId, status])
  @@map("contratos")
}

model ContaReceber {
  id         String    @id @default(cuid())
  empresaId  String
  contratoId String
  descricao  String
  valor      Float
  vencimento DateTime
  status     String    @default("PENDENTE") // PENDENTE | PAGO | ATRASADO | CANCELADO
  pago       Float?    @default(0)
  pagoEm     DateTime?
  criadaEm   DateTime  @default(now())

  empresa  Empresa  @relation(fields: [empresaId], references: [id])
  contrato Contrato @relation(fields: [contratoId], references: [id])

  @@index([empresaId])
  @@index([empresaId, status])
  @@index([contratoId])
  @@index([vencimento, status])
  @@map("contas_receber")
}

// Engenharia Estratégica de Precificação (CAP-06 especializado para a vertical de motos).
// Ver docs/05-modules/commercial/cap-06-oferta-e-precificacao/ENGENHARIA-PRECIFICACAO-MOTOS-MM.md
// para a definição completa de cada parâmetro e do "método do divisor" usado em lib/precificacao.ts.
model ParametroPrecificacao {
  id        String @id @default(cuid())
  empresaId String @unique

  margemEstrategica        Float @default(0.25)
  margemComercial          Float @default(0.16)
  margemNegociacao         Float @default(0.09)
  margemLP                 Float @default(0.04)
  impostosPct              Float @default(0.06)
  comissaoPadraoPct        Float @default(0.03)
  marketingProvisionadoPct Float @default(0.025)
  reservaFinanceiraPct     Float @default(0.02)
  taxaFinanceiraMensal     Float @default(0.02)
  taxaOportunidadeMensal   Float @default(0.015)
  diasEstoqueMeta          Int   @default(45)
  custoOperacionalRateio   Float @default(180)

  fase1MaxDias         Int @default(30)
  fase2MaxDias         Int @default(60)
  fase3MaxDias         Int @default(90)
  saudePremiumMaxDias  Int @default(20)
  saudeSaudavelMaxDias Int @default(45)
  saudeAtencaoMaxDias  Int @default(75)

  atualizadoEm DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@map("parametros_precificacao")
}

// Governança da precificação (Pilar 9): toda alteração de preço fora do fluxo
// automático (override manual de vendedor/gestor/diretoria) fica registrada aqui.
model HistoricoPrecificacao {
  id              String   @id @default(cuid())
  empresaId       String
  unidadeId       String
  precoAnterior   Float?
  precoNovo       Float
  margemUtilizada String   @default("MANUAL") // ESTRATEGICA | COMERCIAL | NEGOCIACAO | LP | MANUAL
  motivo          String
  nivelAprovacao  String   @default("N0") // N0 | N1 | N2 | N3 — ver Pilar 9
  solicitanteId   String?
  aprovadorId     String?
  criadoEm        DateTime @default(now())

  empresa     Empresa  @relation(fields: [empresaId], references: [id])
  unidade     Unidade  @relation(fields: [unidadeId], references: [id])
  solicitante Usuario? @relation("HistoricoSolicitante", fields: [solicitanteId], references: [id])
  aprovador   Usuario? @relation("HistoricoAprovador", fields: [aprovadorId], references: [id])

  @@index([empresaId])
  @@index([unidadeId])
  @@map("historico_precificacao")
}

// =====================================================================
// PROTOCOLOS COMERCIAIS
//
// Cada Protocolo é um processo operacional completo, documentado nos
// 7 níveis / ~20 blocos do framework do Diretor Comercial (identidade,
// estrutura operacional, gestão de execução, controle e auditoria,
// gestão, risco e contingência, melhoria contínua). Os blocos variam de
// forma real entre protocolos (checklists aninhados, kits anexos,
// chaves de rotina/reuniões livres) — por isso cada bloco é guardado
// como Json flexível em vez de colunas rígidas por sub-campo.
//
// Os registros "vivos" (Auditoria, NaoConformidade, PlanoAcao, Melhoria)
// são o que transforma o protocolo de documento em ferramenta de
// gestão: cada execução de auditoria, cada falha encontrada e cada
// plano de ação vira um registro rastreável vinculado ao protocolo.
// =====================================================================

model Protocolo {
  id        String @id @default(cuid())
  empresaId String
  categoria String @default("Protocolos Comerciais")
  nome      String
  versao    String @default("1.0.0")
  status    String @default("ativo") // rascunho | ativo | em_revisao | obsoleto
  ordem     Int?

  // Nível 1 — Identidade do Processo
  objetivo          String?
  resultadoEsperado Json? // string[]
  responsaveis      Json? // string[]

  // Nível 2 — Estrutura Operacional
  processo    Json? // string[] — fluxo macro sequencial
  pop         Json? // {titulo: string, descricao?: string, checklist?: string[]}[]
  regras      Json? // string[] — "7. Protocolo" (regras obrigatórias)
  ferramentas Json? // string[]

  // Nível 3 — Gestão de Execução
  rotina Json? // {chave: string}  ex: {"Diária": "...", "Semanal": "..."}
  sla    Json? // {item: string, prazo: string}[]
  kpis   Json? // {categoria: string, indicador: string}[]

  // Nível 4 — Controle e Auditoria
  auditoriaItens           Json? // string[] — o que verificar
  frequenciaAuditoria      String?
  criteriosConformidade    Json? // string[]
  naoConformidadesCatalogo Json? // string[] — tipos possíveis de falha

  // Nível 5 — Gestão
  reunioes         Json? // {chave: string}
  perguntasAnalise Json? // string[]

  // Nível 6 — Risco e Contingência
  riscos            Json? // string[]
  planoContingencia Json? // {cenario: string, acao: string}[]

  // Nível 7 — Melhoria Contínua
  oportunidadesMelhoriaNotas Json? // string[] — notas iniciais (backlog vivo está em MelhoriaProtocolo)
  automacoesPossiveis        Json? // string[]
  iaAplicavel                Json? // string[]
  revisaoFrequencia          String?
  revisaoResponsavel         String?

  // Anexos livres (ex: "Kit Obrigatório de Entrega", "Checklist de Transferência")
  anexos Json? // {titulo: string, itens: string[]}[]

  criadoPorId  String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  empresa          Empresa                    @relation(fields: [empresaId], references: [id])
  criadoPor        Usuario?                   @relation(fields: [criadoPorId], references: [id])
  auditorias       AuditoriaProtocolo[]
  naoConformidades NaoConformidadeProtocolo[]
  planosAcao       PlanoAcaoProtocolo[]
  melhorias        MelhoriaProtocolo[]
  rotinas          Rotina[]
  processos        Processo[]

  @@index([empresaId])
  @@index([empresaId, categoria])
  @@map("protocolos")
}

model AuditoriaProtocolo {
  id               String   @id @default(cuid())
  empresaId        String
  protocoloId      String
  data             DateTime @default(now())
  responsavelId    String?
  conforme         Boolean
  itensVerificados Json? // {item: string, ok: boolean}[]
  observacoes      String?
  criadoEm         DateTime @default(now())

  protocolo   Protocolo @relation(fields: [protocoloId], references: [id])
  responsavel Usuario?  @relation(fields: [responsavelId], references: [id])

  @@index([empresaId])
  @@index([protocoloId])
  @@map("auditorias_protocolo")
}

model NaoConformidadeProtocolo {
  id          String    @id @default(cuid())
  empresaId   String
  protocoloId String
  tipo        String
  descricao   String?
  data        DateTime  @default(now())
  status      String    @default("ABERTA") // ABERTA | EM_TRATAMENTO | RESOLVIDA
  resolvidoEm DateTime?
  criadoEm    DateTime  @default(now())

  protocolo  Protocolo            @relation(fields: [protocoloId], references: [id])
  planosAcao PlanoAcaoProtocolo[]

  @@index([empresaId])
  @@index([protocoloId])
  @@index([protocoloId, status])
  @@map("nao_conformidades_protocolo")
}

model PlanoAcaoProtocolo {
  id                String    @id @default(cuid())
  empresaId         String
  protocoloId       String
  naoConformidadeId String?
  problema          String
  causa             String?
  solucao           String?
  responsavelId     String?
  prazo             DateTime?
  status            String    @default("PENDENTE") // PENDENTE | EM_ANDAMENTO | CONCLUIDO | ATRASADO
  concluidoEm       DateTime?
  criadoEm          DateTime  @default(now())

  protocolo       Protocolo                 @relation(fields: [protocoloId], references: [id])
  naoConformidade NaoConformidadeProtocolo? @relation(fields: [naoConformidadeId], references: [id])
  responsavel     Usuario?                  @relation(fields: [responsavelId], references: [id])

  @@index([empresaId])
  @@index([protocoloId])
  @@index([protocoloId, status])
  @@map("planos_acao_protocolo")
}

model MelhoriaProtocolo {
  id          String   @id @default(cuid())
  empresaId   String
  protocoloId String
  descricao   String
  status      String   @default("ABERTA") // ABERTA | EM_ANALISE | IMPLEMENTADA | DESCARTADA
  criadoEm    DateTime @default(now())

  protocolo Protocolo @relation(fields: [protocoloId], references: [id])

  @@index([empresaId])
  @@index([protocoloId])
  @@map("melhorias_protocolo")
}

// =====================================================================
// SISTEMA OPERACIONAL COMERCIAL INDIVIDUAL — CRM/rotina/produtividade por
// colaborador, conectado à gestão gerencial via Usuario.gestorId.
// =====================================================================

// Meta de conversão configurável por etapa do funil de 8 estágios.
model MetaFunilEtapa {
  id              String   @id @default(cuid())
  empresaId       String
  etapa           String
  metaPct         Float // 0-1 — usado quando tipoMeta é MINIMO ou MAXIMO_PERDA
  // Meta de custo máximo por lead nesta etapa, em R$ — usado só quando
  // tipoMeta é MAXIMO_CUSTO. Campo separado de metaPct porque a unidade é
  // outra (moeda, não fração 0-1).
  metaCusto       Float?
  tipoMeta        String   @default("MINIMO") // MINIMO | MAXIMO_PERDA | MAXIMO_CUSTO
  tempoMaximoDias Int? // SLA em dias — lead parado além disso vira alerta pro gestor
  atualizadoEm    DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, etapa])
  @@map("metas_funil_etapa")
}

// Custo por lead no topo do funil (ex: gasto com anúncios ÷ leads gerados) —
// única cifra que não dá pra derivar do CRM, por isso é cadastrada
// manualmente. É a partir dela que o custo por lead em cada etapa mais
// funda do funil é calculado (ver montarConversaoFunil/custoPorLead).
model CustoLeadConfig {
  id           String   @id @default(cuid())
  empresaId    String   @unique
  custoPorLead Float    @default(0)
  atualizadoEm DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@map("custo_lead_config")
}

model ContaAnuncio {
  id         String   @id @default(cuid())
  empresaId  String
  usuarioId  String
  nome       String
  plataforma String   @default("MARKETPLACE")
  ativa      Boolean  @default(true)
  criadoEm   DateTime @default(now())

  empresa  Empresa           @relation(fields: [empresaId], references: [id])
  usuario  Usuario           @relation(fields: [usuarioId], references: [id])
  anuncios AnuncioProducao[]

  @@index([empresaId, usuarioId])
  @@map("contas_anuncio")
}

model AnuncioProducao {
  id         String   @id @default(cuid())
  empresaId  String
  usuarioId  String
  contaId    String
  unidadeId  String?
  data       DateTime @default(now())
  horario    String?
  produto    String?
  quantidade Int      @default(1)
  status     String   @default("PUBLICADO") // PUBLICADO | REMOVIDO | ERRO
  criadoEm   DateTime @default(now())

  empresa Empresa      @relation(fields: [empresaId], references: [id])
  usuario Usuario      @relation(fields: [usuarioId], references: [id])
  conta   ContaAnuncio @relation(fields: [contaId], references: [id])
  unidade Unidade?     @relation(fields: [unidadeId], references: [id])

  @@index([empresaId, usuarioId])
  @@index([empresaId, data])
  @@map("anuncios_producao")
}

model ConteudoSocialMedia {
  id               String   @id @default(cuid())
  empresaId        String
  usuarioId        String
  tipo             String // STORY | REELS | POST | VIDEO | FOTO | OFERTA | EDUCATIVO | COMERCIAL
  plataforma       String
  data             DateTime @default(now())
  objetivo         String?
  status           String   @default("PUBLICADO") // PLANEJADO | PRODUZIDO | PUBLICADO
  link             String?
  alcance          Int?
  visualizacoes    Int?
  interacoes       Int?
  leadsGerados     Int?     @default(0)
  vendasOriginadas Int?     @default(0)
  observacoes      String?
  criadoEm         DateTime @default(now())

  empresa Empresa @relation(fields: [empresaId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([empresaId, usuarioId])
  @@index([empresaId, data])
  @@map("conteudo_social_media")
}

// Rotina = definição do checklist recorrente (blocos ordenados). Blocos em
// JSON — mesmo padrão de Protocolo.pop — porque a composição varia por
// cargo/rotina (ex: BLOCO 01 — ABERTURA, BLOCO 02 — PROSPECÇÃO...).
model Rotina {
  id                  String   @id @default(cuid())
  empresaId           String
  nome                String
  descricao           String?
  papelAlvo           String?
  departamento        String?
  frequencia          String   @default("DIARIA") // DIARIA | SEMANAL | MENSAL
  horario             String?
  blocos              Json // [{ titulo, itens: [string] }]
  evidenciaNecessaria Boolean  @default(false)
  protocoloId         String?
  processoId          String?
  status              String   @default("ATIVA") // ATIVA | ARQUIVADA
  criadoPorId         String?
  criadoEm            DateTime @default(now())
  atualizadoEm        DateTime @updatedAt

  empresa   Empresa          @relation(fields: [empresaId], references: [id])
  protocolo Protocolo?       @relation(fields: [protocoloId], references: [id])
  processo  Processo?        @relation(fields: [processoId], references: [id])
  execucoes RotinaExecucao[]

  @@index([empresaId])
  @@map("rotinas")
}

// Checklist do dia por usuário. `data` é sempre truncada para meia-noite pela
// aplicação — é o que faz o @@unique funcionar como "uma execução por
// rotina+usuário+dia".
model RotinaExecucao {
  id          String    @id @default(cuid())
  empresaId   String
  rotinaId    String
  usuarioId   String
  data        DateTime  @default(now())
  itensStatus Json // [{ item: string, status: string }]
  status      String    @default("PENDENTE") // PENDENTE | EM_ANDAMENTO | CONCLUIDA | ATRASADA | NAO_REALIZADA | CANCELADA
  evidencia   String?
  observacao  String?
  concluidoEm DateTime?
  criadoEm    DateTime  @default(now())

  empresa Empresa @relation(fields: [empresaId], references: [id])
  rotina  Rotina  @relation(fields: [rotinaId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([rotinaId, usuarioId, data])
  @@index([empresaId, usuarioId])
  @@map("rotina_execucoes")
}

model Tarefa {
  id            String    @id @default(cuid())
  empresaId     String
  titulo        String
  descricao     String?
  responsavelId String
  criadoPorId   String
  prazo         DateTime?
  prioridade    String    @default("NORMAL") // BAIXA | NORMAL | ALTA | URGENTE
  status        String    @default("PENDENTE") // PENDENTE | EM_ANDAMENTO | CONCLUIDA | ATRASADA | CANCELADA
  vinculoTipo   String? // OPORTUNIDADE | ROTINA | PROTOCOLO | PROCESSO
  vinculoId     String?
  concluidoEm   DateTime?
  criadoEm      DateTime  @default(now())

  empresa     Empresa @relation(fields: [empresaId], references: [id])
  responsavel Usuario @relation("TarefaResponsavel", fields: [responsavelId], references: [id])
  criadoPor   Usuario @relation("TarefaCriador", fields: [criadoPorId], references: [id])

  @@index([empresaId, responsavelId])
  @@index([empresaId, status])
  @@map("tarefas")
}

// Processo — separado de Protocolo (o protocolo é o "como fazer" oficial; o
// processo é o desenho operacional do departamento, que pode referenciar um
// protocolo e uma rotina).
model Processo {
  id            String   @id @default(cuid())
  empresaId     String
  nome          String
  departamento  String?
  responsavelId String?
  cargo         String?
  objetivo      String?
  fluxo         Json?
  pop           Json?
  protocoloId   String?
  ferramentas   Json?
  kpis          Json?
  auditoria     Json?
  contingencia  Json?
  status        String   @default("ativo")
  criadoPorId   String?
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  empresa   Empresa    @relation(fields: [empresaId], references: [id])
  protocolo Protocolo? @relation(fields: [protocoloId], references: [id])
  rotinas   Rotina[]

  @@index([empresaId])
  @@map("processos")
}

model Treinamento {
  id                   String   @id @default(cuid())
  empresaId            String
  nome                 String
  categoria            String?
  papelAlvo            String?
  departamento         String?
  descricao            String?
  videoUrl             String?
  pdfUrl               String?
  documentoUrl         String?
  link                 String?
  materialComplementar Json?
  avaliacao            Json?
  status               String   @default("ativo")
  criadoEm             DateTime @default(now())

  empresa   Empresa                @relation(fields: [empresaId], references: [id])
  progresso TreinamentoProgresso[]

  @@index([empresaId])
  @@map("treinamentos")
}

model TreinamentoProgresso {
  id            String    @id @default(cuid())
  empresaId     String
  treinamentoId String
  usuarioId     String
  status        String    @default("DISPONIVEL") // DISPONIVEL | INICIADO | CONCLUIDO
  percentual    Float     @default(0)
  nota          Float?
  concluidoEm   DateTime?
  atualizadoEm  DateTime  @updatedAt

  empresa     Empresa     @relation(fields: [empresaId], references: [id])
  treinamento Treinamento @relation(fields: [treinamentoId], references: [id])
  usuario     Usuario     @relation(fields: [usuarioId], references: [id])

  @@unique([treinamentoId, usuarioId])
  @@index([empresaId, usuarioId])
  @@map("treinamento_progresso")
}

// Auditoria genérica (CRM/Rotina/Anúncio/Conteúdo/Treinamento/Processo).
// AuditoriaProtocolo continua existindo à parte, sem mudança, só para
// protocolos.
model Auditoria {
  id               String   @id @default(cuid())
  empresaId        String
  entidadeTipo     String // CRM | ROTINA | ANUNCIO | CONTEUDO | TREINAMENTO | PROCESSO
  entidadeId       String
  responsavelId    String?
  data             DateTime @default(now())
  conforme         Boolean
  itensVerificados Json?
  observacoes      String?
  criadoEm         DateTime @default(now())

  empresa     Empresa     @relation(fields: [empresaId], references: [id])
  responsavel Usuario?    @relation(fields: [responsavelId], references: [id])
  planosAcao  PlanoAcao[]

  @@index([empresaId])
  @@index([empresaId, entidadeTipo, entidadeId])
  @@map("auditorias")
}

// Plano de ação genérico (mesmo padrão de PlanoAcaoProtocolo, para qualquer
// não-conformidade fora do escopo de protocolo).
model PlanoAcao {
  id            String    @id @default(cuid())
  empresaId     String
  auditoriaId   String?
  origemTipo    String? // AUDITORIA | INSIGHT | MANUAL
  problema      String
  causa         String?
  solucao       String?
  responsavelId String?
  prazo         DateTime?
  status        String    @default("PENDENTE") // PENDENTE | EM_ANDAMENTO | CONCLUIDO | ATRASADO
  concluidoEm   DateTime?
  criadoEm      DateTime  @default(now())

  empresa     Empresa    @relation(fields: [empresaId], references: [id])
  auditoria   Auditoria? @relation(fields: [auditoriaId], references: [id])
  responsavel Usuario?   @relation(fields: [responsavelId], references: [id])

  @@index([empresaId])
  @@map("planos_acao")
}

model Notificacao {
  id           String   @id @default(cuid())
  empresaId    String
  usuarioId    String
  tipo         String
  titulo       String
  mensagem     String
  lida         Boolean  @default(false)
  entidadeTipo String?
  entidadeId   String?
  criadoEm     DateTime @default(now())

  empresa Empresa @relation(fields: [empresaId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([empresaId, usuarioId, lida])
  @@map("notificacoes")
}

// Pesos do score de performance — nunca só volume de vendas (ver Central de
// Insights / Ranking). Defaults batem com o exemplo do prompt original.
model ScoreConfig {
  id                String   @id @default(cuid())
  empresaId         String   @unique
  pesoComercial     Float    @default(0.40)
  pesoProdutividade Float    @default(0.20)
  pesoProcessos     Float    @default(0.15)
  pesoCrm           Float    @default(0.10)
  pesoConteudo      Float    @default(0.05)
  pesoTreinamentos  Float    @default(0.05)
  pesoRotinas       Float    @default(0.05)
  atualizadoEm      DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@map("score_config")
}

// Trilha genérica de alteração (quem/quando/valor anterior/valor novo),
// gravada via hook do Prisma Client ($extends), não manualmente por rota.
model LogAuditoria {
  id            String   @id @default(cuid())
  empresaId     String
  entidadeTipo  String
  entidadeId    String
  usuarioId     String?
  acao          String // CREATE | UPDATE | DELETE
  campoAlterado String?
  valorAnterior String?
  valorNovo     String?
  criadoEm      DateTime @default(now())

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@index([empresaId, entidadeTipo, entidadeId])
  @@map("log_auditoria")
}

// =====================================================================
// PRÓ-LABORE — módulo pessoal de acompanhamento de liquidez do
// faturamento da operação comercial. Independente do modelo multi-tenant
// (Empresa/Usuario) do Commercial OS: usuário único, login próprio.
// =====================================================================

model ProLaboreUsuario {
  id           String   @id @default(cuid())
  nome         String
  email        String   @unique
  senhaHash    String
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  parametro                 ParametroLiquidez?
  vendas                    Venda[]
  vendedores                Vendedor[]
  funilMensal               FunilMensal[]
  gastosAnuncios            GastoAnuncioMensal[]
  leads                     Lead[]
  metasFunil                MetaFunilProLabore[]
  agendaItens               AgendaItem[]
  ocorrencias               Ocorrencia[]
  socialMediaContas         SocialMediaConta[]
  planoCrescimentoAcoes     PlanoCrescimentoAcao[]
  planoCrescimentoSnapshots PlanoCrescimentoSnapshot[]
  reunioes                  Reuniao[]
  notas                     Nota[]
  pastas                    Pasta[]
  mapasMentais              MapaMental[]
  apresentacoes             Apresentacao[]
  reunioesDepartamentos     ReuniaoDepartamento[]
  reunioesPastas            ReuniaoPasta[]
  pagamentosComissao        PagamentoComissao[]
  smNotificacoes            SmNotificacao[]
  smMembro                  SmMembro?
  smPermissao               SmPermissao?
  smMotos                   SmMotoEstoque[]
  smPautas                  SmPauta[]
  smConfig                  SmConfig?
  smConversas               SmConversa[]
  smLinks                   SmLinkRastreado[]
  smTestes                  SmTeste[]
  smGanchos                 SmGancho[]
  smAutomacoes              SmAutomacao[]
  smRespostasRapidas        SmRespostaRapida[]

  @@map("pro_labore_usuarios")
}

// Vendedor da operação. Pode ou não ter login próprio: email/senhaHash só
// são preenchidos quando o DONO concede acesso individual — até lá é só um
// registro pra atribuir vendas e montar o ranking de produção por pessoa.
model Vendedor {
  id                   String   @id @default(cuid())
  usuarioId            String
  nome                 String
  ativo                Boolean  @default(true)
  email                String?  @unique
  senhaHash            String?
  // VENDEDOR (padrão) só vê/mexe na própria produção. SUPERVISOR vê o
  // painel e o CRM com o escopo da equipe inteira (igual ao dono), mas sem
  // acesso a Vendas/Vendedores/Indicadores/Configurações nem às cifras
  // pessoais do dono (pró-labore, comissões agregadas, gasto com anúncios)
  // — essas rotas continuam exclusivas de requireDono. Só entra em vigor no
  // próximo login, porque o papel vai dentro do JWT.
  papel                String   @default("VENDEDOR")
  // Teto de comissão por venda individual deste vendedor — sobrepõe o
  // ParametroLiquidez.tetoComissaoPadrao da conta quando definido. Só o
  // dono edita (a rota é requireDono); nulo = usa o padrão da conta.
  tetoComissaoPorVenda Float?
  // Meta de faturamento mensal individual deste vendedor — sobrepõe o
  // ParametroLiquidez.metaMensalPadrao da conta quando definida. Vendedor
  // não vê a meta anual da operação (isso é visão de dono/supervisor); no
  // lugar, o dashboard dele mostra essa meta mensal própria.
  metaMensal           Float?
  criadoEm             DateTime @default(now())
  atualizadoEm         DateTime @updatedAt

  usuario             ProLaboreUsuario     @relation(fields: [usuarioId], references: [id])
  vendas              Venda[]
  pagamentosComissao  PagamentoComissao[]
  leads               Lead[]
  ocorrencias         Ocorrencia[]
  assistenteComercial AssistenteComercial?
  socialMediaContas   SocialMediaConta[]

  @@index([usuarioId])
  @@map("pro_labore_vendedores")
}

// Contagem do funil de vendas por mês (Leads/Abordados/Negociação/Proposta),
// cadastrada manualmente. Fechamento não é guardado aqui — é sempre a
// contagem real de Venda no mês, pra não haver divergência entre os dois.
model FunilMensal {
  id            String   @id @default(cuid())
  usuarioId     String
  mesReferencia DateTime // primeiro dia do mês de referência
  leads         Int      @default(0)
  abordados     Int      @default(0)
  negociacao    Int      @default(0)
  proposta      Int      @default(0)
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  usuario ProLaboreUsuario @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, mesReferencia])
  @@map("pro_labore_funil_mensal")
}

// Gasto com anúncios por mês, cadastrado manualmente — base do ROAS/CAC.
model GastoAnuncioMensal {
  id            String   @id @default(cuid())
  usuarioId     String
  mesReferencia DateTime // primeiro dia do mês de referência
  valor         Float
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  usuario ProLaboreUsuario @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, mesReferencia])
  @@map("pro_labore_gasto_anuncios_mensal")
}

// Teto de pró-labore que pode ser sacado por venda — linha única por
// usuário, editável a qualquer momento.
model ParametroLiquidez {
  id                        String  @id @default(cuid())
  usuarioId                 String  @unique
  // Teto de pró-labore por venda — é sempre o dono, sacado de toda venda
  // registrada na operação, independente de quem vendeu.
  tetoProLaborePorVenda     Float   @default(900)
  // Teto padrão de comissão por venda, usado quando o vendedor daquela
  // venda não tem um Vendedor.tetoComissaoPorVenda próprio definido.
  tetoComissaoPadrao        Float   @default(900)
  // Tetos usados só quando o Lead está classificado como "R" (renegociação)
  // — substituem tetoProLaborePorVenda/tetoComissaoPadrao (e qualquer teto
  // individual do vendedor) na conversão em venda. Lead sem classificação
  // ou classificado como "P" continua usando os tetos normais acima.
  tetoProLaboreRenegociacao Float   @default(600)
  tetoComissaoRenegociacao  Float   @default(0)
  metaFaturamentoAnual      Float   @default(5000000)
  // Meta mensal padrão, usada por vendedores sem Vendedor.metaMensal
  // próprio definido. Substitui a meta anual no dashboard de quem loga
  // como VENDEDOR (dono e supervisor continuam vendo a meta anual).
  metaMensalPadrao          Float   @default(0)
  // Custo por lead no topo da jornada de compra (ex: gasto com anúncios ÷
  // leads gerados) — única cifra que o Pró-Labore não deriva sozinho,
  // cadastrada manualmente. Alimenta o custo por lead calculado em cada
  // etapa mais funda da jornada (ver FunilJourney no dashboard).
  custoPorLeadTopo          Float   @default(0)
  fraseMotivacional         String?
  // Meta de volume de produção de conteúdo (posts/reels/stories por
  // semana) usada pra auditar a equipe de Social Media — comparação
  // simples de "quanto devia vs quanto saiu".
  metaPostagensSemanais     Int     @default(3)

  // ===== Limiares da Auditoria comercial da Agenda (todos parametrizáveis —
  // nada disso pode ficar hardcoded no front, pra permitir calibrar por
  // operação sem precisar de deploy) =====
  // Aderência (% de itens da Agenda cumpridos no prazo) acima disso = "Em
  // dia"/perfil de aderência alta; abaixo de agendaLimiarAtencaoPct = "Crítico".
  agendaLimiarBomPct              Float @default(80)
  agendaLimiarAtencaoPct          Float @default(50)
  // Conversão do funil de Leads (abordado → fechado) no período, acima
  // disso é considerada "efetividade alta" pra fins da matriz 2x2.
  agendaLimiarEfetividadeAltaPct  Float @default(30)
  // Coeficiente de variação (desvio padrão ÷ média) da aderência diária no
  // período — acima disso o consultor é classificado como "Oscilante".
  agendaLimiarOscilacaoPct        Float @default(35)
  // Regra de alerta: aderência abaixo desse % por N dias seguidos dispara o
  // card "Em alerta".
  agendaAlertaAderenciaPct        Float @default(50)
  agendaAlertaDiasConsecutivos    Int   @default(3)
  // Regra de alerta: queda de efetividade acima desse % em relação à média
  // móvel do próprio consultor (não é limiar absoluto — é comparação com o
  // histórico da pessoa).
  agendaAlertaQuedaEfetividadePct Float @default(30)
  // Reconhecimento automático: quantas semanas seguidas no perfil
  // "Referência" pra disparar um destaque positivo (em vez de só sinalizar
  // problema, como a Agenda faz hoje).
  agendaReconhecimentoSemanas     Int   @default(4)

  // Lista de motivos de Ocorrência, editável em Configurações — CSV numa
  // coluna só (mesmo padrão de AgendaItem.diasSemana/vendedorIds), em vez
  // de uma tabela à parte, já que é só uma lista de rótulos por conta.
  motivosOcorrenciaCsv String @default("Atraso recorrente,Não cumprimento de meta,Não preenchimento do CRM,Postura com cliente,Quebra de processo comercial,Falta não justificada,Não cumprimento de protocolo")

  // ===== Metas do Plano de Crescimento — limiares que o motor de regras
  // (lib/planoCrescimento.ts) usa pra classificar cada pilar em estágio.
  // Começaram hardcoded no motor; viraram parametrizáveis porque o que é
  // "ROAS saudável" ou "conversão boa" varia demais de operação pra
  // operação pra ficar fixo no código. =====
  planoRoasMinimo                 Float @default(1)
  planoRoasSaudavel               Float @default(3)
  planoConversaoMinimaPct         Float @default(5)
  planoConversaoConsolidadaPct    Float @default(10)
  planoEngajamentoMinimoPct       Float @default(2)
  planoLeadsOrganicosMinimo       Int   @default(5)
  planoConcentracaoMaximaLiderPct Float @default(70)

  atualizadoEm DateTime @updatedAt

  usuario ProLaboreUsuario @relation(fields: [usuarioId], references: [id])

  @@map("pro_labore_parametros")
}

// Metas por etapa da jornada de compra (Leads/Abordados/Negociação/
// Proposta/Fechamento) — mesmo conceito de MetaFunilEtapa do CRM principal
// (conversão mínima, perda máxima ou custo máximo por etapa), só que
// escopado ao usuário dono do Pró-Labore em vez de Empresa.
model MetaFunilProLabore {
  id           String   @id @default(cuid())
  usuarioId    String
  etapa        String // LEAD | ABORDADO | NEGOCIACAO | PROPOSTA | FECHADO
  metaPct      Float    @default(0) // 0-1 — usado quando tipoMeta é MINIMO ou MAXIMO_PERDA
  metaCusto    Float? // R$ — usado só quando tipoMeta é MAXIMO_CUSTO
  tipoMeta     String   @default("MINIMO") // MINIMO | MAXIMO_PERDA | MAXIMO_CUSTO
  atualizadoEm DateTime @updatedAt

  usuario ProLaboreUsuario @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, etapa])
  @@map("pro_labore_metas_funil")
}

// Cada venda/negociação fechada — cadastrada só pelo dono. O pró-labore
// (sempre do dono, sacado de qualquer venda) e a comissão (só quando a
// venda tem um vendedor atribuído) são valores independentes: cada um
// respeita o próprio teto e nunca ultrapassa o valor da venda.
model Venda {
  id             String   @id @default(cuid())
  usuarioId      String
  vendedorId     String?
  data           DateTime
  valorVenda     Float
  valorProLabore Float
  valorComissao  Float?
  observacao     String?
  // Comprovante em que a comissão desta venda foi paga ao vendedor (nulo =
  // ainda a pagar). Enquanto estiver pago, valor e vendedor da comissão
  // ficam travados — pra mudar, desmarca o pagamento antes.
  pagamentoComissaoId String?
  // Idem pro pró-labore: comprovante em que a retirada do pró-labore desta
  // venda foi registrada (nulo = ainda não pago). Trava o valorProLabore.
  pagamentoProLaboreId String?
  // Origem herdada do lead na conversão (seção 3.5): a venda continua
  // creditada ao post mesmo fechada depois do período analisado.
  origem         String? // INSTAGRAM_ORGANICO
  postCode       String?
  midiaId        String?
  canalEntrada   String?
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  usuario            ProLaboreUsuario   @relation(fields: [usuarioId], references: [id])
  vendedor           Vendedor?          @relation(fields: [vendedorId], references: [id])
  pagamentoComissao  PagamentoComissao? @relation("PagamentoDaComissao", fields: [pagamentoComissaoId], references: [id], onDelete: SetNull)
  pagamentoProLabore PagamentoComissao? @relation("PagamentoDoProLabore", fields: [pagamentoProLaboreId], references: [id], onDelete: SetNull)
  lead               Lead?

  @@index([usuarioId, data])
  @@index([vendedorId])
  @@index([pagamentoComissaoId])
  @@index([pagamentoProLaboreId])
  @@map("pro_labore_vendas")
}

// Pagamento registrado a partir das vendas — agrupa as vendas pagas de uma
// vez e vira o comprovante numerado que se imprime e assina. Dois tipos:
//   COMISSAO  — comissão paga a um vendedor (vendedorId preenchido);
//   PROLABORE — retirada do pró-labore do dono (vendedorId nulo; quem recebe
//               fica em `recebedor`).
// A numeração é sequencial por conta e por tipo. valorTotal é recalculado
// quando uma venda sai do pagamento.
model PagamentoComissao {
  id             String   @id @default(cuid())
  usuarioId      String
  tipo           String   @default("COMISSAO") // COMISSAO | PROLABORE
  vendedorId     String?
  numero         Int
  pagoEm         DateTime
  formaPagamento String? // PIX | DINHEIRO | TRANSFERENCIA | OUTRO
  observacao     String?
  // Nome de quem paga, como sai no comprovante (comissão: padrão é o nome
  // do dono; pró-labore: a empresa).
  pagador        String
  // Só no pró-labore: nome de quem recebe (padrão: o dono).
  recebedor      String?
  valorTotal     Float
  // Preenchido quando todas as vendas saíram do pagamento: o registro fica
  // (o número nunca é reaproveitado) e o comprovante aparece como cancelado.
  canceladoEm    DateTime?
  criadoEm       DateTime @default(now())

  usuario         ProLaboreUsuario @relation(fields: [usuarioId], references: [id])
  vendedor        Vendedor?        @relation(fields: [vendedorId], references: [id], onDelete: Restrict)
  vendas          Venda[]          @relation("PagamentoDaComissao")
  vendasProLabore Venda[]          @relation("PagamentoDoProLabore")

  @@unique([usuarioId, tipo, numero])
  @@index([vendedorId])
  @@map("pro_labore_pagamentos_comissao")
}

// Lead/oportunidade da esteira comercial do Pró-Labore. Substitui a
// contagem manual do FunilMensal quando existe dado real: o /painel prefere
// os números computados daqui e só cai pro FunilMensal em meses sem Lead
// nenhum (histórico anterior à funcionalidade).
model Lead {
  id              String    @id @default(cuid())
  usuarioId       String
  vendedorId      String?
  nomeCliente     String
  telefone        String?
  email           String?
  cpf             String?
  endereco        String?
  modeloInteresse String? // moto que o cliente tem interesse — separado de observacao pra facilitar relatório
  observacao      String?
  tipoLead        String? // TRAFEGO | ORGANICO — canal de origem do lead, pra analisar performance por canal
  // Quanto o cliente teria capacidade de gerar de faturamento — base pro
  // indicador de "oportunidade de faturamento" que passou pelo funil.
  // Default 0 só pra não quebrar leads já cadastrados antes deste campo
  // existir; obrigatório em todo lead novo (exigido na validação da rota).
  valorNegociacao Float     @default(0)
  // P | R — como a negociação vai ser paga, e não como o lead entrou
  // (isso é tipoLead/canal). Muda o teto de pró-labore/comissão usado na
  // conversão em venda (ver tetoProLaboreRenegociacao/tetoComissaoRenegociacao
  // em ParametroLiquidez) — null se ainda não classificada, o que a
  // conversão trata igual a P (pagamento integral, tetos normais da conta).
  tipoNegociacao  String?
  estagio         String    @default("LEAD") // LEAD | ABORDADO | NEGOCIACAO | PROPOSTA | FECHADO | PERDIDO
  vendaId         String?   @unique
  // Origem vinda do Social Media (seção 3.4): o lead criado pelo Atendimento
  // guarda o post e o canal de entrada, e a venda herda isso pelo lead.
  origem          String? // INSTAGRAM_ORGANICO
  postCode        String? // #P-DDMM-MODELO, #S-..., #BIO
  midiaId         String? // id da mídia no Instagram
  canalEntrada    String? // DIRECT | COMENTARIO | COMENTE_QUERO | RESPOSTA_STORY | LINK_WHATSAPP
  conversaId      String?
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  fechadoEm       DateTime?

  usuario             ProLaboreUsuario       @relation(fields: [usuarioId], references: [id])
  vendedor            Vendedor?              @relation(fields: [vendedorId], references: [id])
  venda               Venda?                 @relation(fields: [vendaId], references: [id])
  historico           LeadEstagioHistorico[]
  assistenteConversas AssistenteConversa[]

  @@index([usuarioId])
  @@index([usuarioId, estagio])
  @@index([vendedorId])
  @@map("pro_labore_leads")
}

// Trilha de transição de estágio do Lead — base pra conversão etapa-a-etapa
// e tempo médio no funil, espelhando o EstagioHistorico do CRM principal.
model LeadEstagioHistorico {
  id              String   @id @default(cuid())
  leadId          String
  estagioAnterior String?
  estagioNovo     String
  criadoEm        DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id])

  @@index([leadId])
  @@map("pro_labore_lead_estagio_historico")
}

// Agenda de trabalho: itens de rotina (metas diárias, processos, auditorias,
// protocolos etc.) cadastrados pelo dono/supervisor pra toda a equipe
// seguir. Um item é único (uma data específica) ou recorrente (dias da
// semana, com início/fim opcionais) — a ocorrência de cada dia é resolvida
// no cliente a partir dessas regras, sem precisar materializar uma linha
// por dia por pessoa.
model AgendaItem {
  id               String    @id @default(cuid())
  usuarioId        String
  titulo           String
  descricao        String?
  categoria        String // META | PROCESSO | AUDITORIA | PROTOCOLO | OUTRO | REUNIAO
  tipo             String // UNICO | RECORRENTE
  data             DateTime? // usado quando tipo = UNICO
  diasSemana       String? // usado quando tipo = RECORRENTE — CSV de 0(dom) a 6(sáb), ex "1,2,3,4,5"
  dataInicio       DateTime? // opcional, só pra RECORRENTE — a partir de quando vale
  dataFim          DateTime? // opcional, só pra RECORRENTE — até quando vale
  horario          String? // horário previsto no dia, "HH:mm" (opcional — nem toda rotina tem hora fixa)
  // Sem alvo específico nenhum (vendedorIds vazio E incluiDono false) =
  // toda a equipe (cada pessoa segue e marca a própria conclusão,
  // independente das outras). Com alvo(s), só essas pessoas — pode ser
  // várias ao mesmo tempo: um ou mais vendedores (CSV de ids em
  // vendedorIds) e/ou o dono ("Head Comercial", incluiDono).
  vendedorIds      String? // CSV de ids de Vendedor — sem FK porque é multivalorado
  incluiDono       Boolean   @default(false)
  // Pra atividades externas (visita, entrega, test-drive) — exige um selo
  // pontual de localização no momento em que a pessoa marca "feito"
  // (coordenadas na própria AgendaConclusao). Não é rastreamento contínuo:
  // só a posição naquele instante, uma vez, igual a um check-in.
  exigeLocalizacao Boolean   @default(false)
  ativo            Boolean   @default(true)
  criadoEm         DateTime  @default(now())
  atualizadoEm     DateTime  @updatedAt

  usuario    ProLaboreUsuario  @relation(fields: [usuarioId], references: [id])
  conclusoes AgendaConclusao[]
  inicios    AgendaInicio[]

  @@index([usuarioId])
  @@map("pro_labore_agenda_itens")
}

// Registro de "feito" de um item num dia específico, por pessoa. `autorId`
// é o usuarioId do dono OU o id do Vendedor (supervisor ou vendedor comum)
// que concluiu — não é FK porque pode apontar pra duas tabelas diferentes,
// e a resolução de "quem sou eu" já é feita no backend a partir do token.
model AgendaConclusao {
  id             String   @id @default(cuid())
  agendaItemId   String
  autorId        String
  dataReferencia DateTime
  concluidoEm    DateTime @default(now())
  // Selo de localização pontual — só preenchido quando o item tem
  // exigeLocalizacao=true e o navegador da pessoa cedeu a permissão no
  // instante do check-in. Fica null quando o item não exige, ou quando
  // exige mas a permissão foi negada/indisponível (a conclusão ainda vale,
  // só sem o selo).
  latitude       Float?
  longitude      Float?

  item AgendaItem @relation(fields: [agendaItemId], references: [id])

  @@unique([agendaItemId, autorId, dataReferencia])
  @@index([agendaItemId])
  @@map("pro_labore_agenda_conclusoes")
}

// Registro de "iniciado" de um item num dia — sinal independente da
// conclusão (uma tabela nova, e não uma coluna a mais em AgendaConclusao,
// porque a existência de uma linha em AgendaConclusao já É a semântica de
// "feito"; misturar os dois estados na mesma tabela obrigaria a tornar
// concluidoEm opcional e revisar todo código que assume que a linha existe
// = concluído). Alimenta o funil previstas → iniciadas → concluídas no
// prazo da Auditoria comercial.
model AgendaInicio {
  id             String   @id @default(cuid())
  agendaItemId   String
  autorId        String
  dataReferencia DateTime
  iniciadoEm     DateTime @default(now())

  item AgendaItem @relation(fields: [agendaItemId], references: [id])

  @@unique([agendaItemId, autorId, dataReferencia])
  @@index([agendaItemId])
  @@map("pro_labore_agenda_inicios")
}

// =====================================================================
// OCORRÊNCIAS — auditoria disciplinar/de desempenho da equipe comercial.
// Registro formal com protocolo, prazo de correção, histórico imutável de
// mudanças e (opcional) documento gerado pro vendedor assinar. Nunca é
// excluída — só encerrada — pra preservar o rastro como auditoria.
// =====================================================================
model Ocorrencia {
  id         String @id @default(cuid())
  usuarioId  String
  // OC-{ano}-{sequencial de 4 dígitos}, reiniciando a cada ano — gerado no
  // backend a partir da contagem de ocorrências já criadas naquele ano
  // pra essa conta. Nunca editado depois de criado.
  protocolo  String @unique
  vendedorId String

  tipo      String // Disciplinar | Ineficiência de Produção | Feedback de Melhoria | Feedback Positivo | Outros
  // Subcategoria — lista sugerida vem de ParametroLiquidez.motivosOcorrenciaCsv,
  // mas o campo aqui é livre (String) pra não travar em nenhum lançamento
  // se a lista mudar depois ou o motivo real não estiver nela ainda.
  motivo    String
  gravidade String // Leve | Moderada | Grave | Gravíssima
  descricao String
  // Referências a evidências (link, nome de arquivo já hospedado em outro
  // lugar etc.) — CSV simples, mesmo padrão de AgendaItem.vendedorIds; não
  // existe upload/armazenamento de arquivo nesse projeto ainda.
  anexosCsv String?

  dataOcorrencia DateTime
  dataRegistro   DateTime @default(now())
  registradoPor  String // nome de quem lançou (dono ou supervisor)

  planoDeCorrecao String?
  prazoCorrecao   DateTime?

  status         String @default("ABERTA") // ABERTA | EM_PRAZO | EM_VERIFICACAO | RESOLVIDA | REINCIDENTE | ESCALONADA | ENCERRADA
  medidaAplicada String @default("NENHUMA") // NENHUMA | ADVERTENCIA_VERBAL | ADVERTENCIA_ESCRITA | SUSPENSAO | DESLIGAMENTO

  // Auto-relação: aponta pra ocorrência anterior do mesmo vendedor/motivo
  // quando esta é uma reincidência.
  ocorrenciaAnteriorId String?

  documentoGeradoUrl     String?
  documentoGeradoEm      DateTime?
  assinaturaVendedorOk   Boolean   @default(false)
  assinaturaVendedorData DateTime?
  assinaturaGestorOk     Boolean   @default(false)
  assinaturaGestorData   DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuario            ProLaboreUsuario      @relation(fields: [usuarioId], references: [id])
  vendedor           Vendedor              @relation(fields: [vendedorId], references: [id])
  ocorrenciaAnterior Ocorrencia?           @relation("Reincidencia", fields: [ocorrenciaAnteriorId], references: [id])
  reincidencias      Ocorrencia[]          @relation("Reincidencia")
  historico          OcorrenciaHistorico[]

  @@index([usuarioId])
  @@index([usuarioId, status])
  @@index([vendedorId])
  @@map("pro_labore_ocorrencias")
}

// Log imutável de mudanças da Ocorrência — toda alteração de campo
// relevante depois da criação gera uma linha aqui (quem, quando, o quê),
// nunca sobrescreve o registro original em silêncio.
model OcorrenciaHistorico {
  id             String   @id @default(cuid())
  ocorrenciaId   String
  autor          String
  acao           String // texto curto descrevendo a mudança
  statusAnterior String?
  statusNovo     String?
  criadoEm       DateTime @default(now())

  ocorrencia Ocorrencia @relation(fields: [ocorrenciaId], references: [id])

  @@index([ocorrenciaId])
  @@map("pro_labore_ocorrencia_historico")
}

// Conta do Instagram conectada via Instagram Graph API. Um usuarioId (dono)
// só conecta uma conta — o accessToken é de longa duração (~60 dias) e
// precisa ser renovado antes de expirar (ver rota de refresh).
// Uma conta do Instagram por PESSOA: o dono conecta a dele e cada
// vendedor/supervisor pode conectar a própria — ninguém vê a de outro.
// `titular` é a chave única da pessoa ("dono:<usuarioId>" ou
// "vendedor:<vendedorId>"); um mesmo Instagram não pode ser ligado por duas
// pessoas (instagramUserId único), o que impede alguém da equipe de
// conectar a conta de outra pessoa pra ver os dados dela.
model SocialMediaConta {
  id                    String    @id @default(cuid())
  usuarioId             String
  titular               String    @unique
  vendedorId            String?
  instagramUserId       String    @unique
  nomeUsuario           String
  nomeExibicao          String?
  fotoUrl               String?
  seguidores            Int       @default(0)
  seguindo              Int       @default(0)
  publicacoesTotal      Int       @default(0)
  biografia             String?
  site                  String?
  tipoConta             String? // BUSINESS | MEDIA_CREATOR
  // Demografia da audiência (seguidores + contas engajadas no mês), no
  // formato { seguidores: { idade, genero, cidade, pais }, engajados: {...} }
  // — cada dimensão é uma lista { chave, valor }. É um retrato "de hoje":
  // a API não devolve histórico de demografia, então só o último fica.
  demografia            Json?
  // Média de seguidores online por hora do dia (24 posições, 0h..23h, no
  // fuso da conta). Null quando a API não devolve (conta pequena ou métrica
  // indisponível).
  seguidoresOnline      Json?
  // Origem do alcance dos últimos 30 dias (seguidores x não seguidores, e
  // por formato) — ver buscarDistribuicaoAlcance.
  distribuicaoAlcance   Json?
  // Nunca exposto pro frontend — só usado nas chamadas server-to-server
  // pra Graph API.
  accessToken           String
  tokenExpiraEm         DateTime
  conectadoEm           DateTime  @default(now())
  atualizadoEm          DateTime  @updatedAt
  ultimaSincronizacaoEm DateTime?
  // Última falha de sincronização (mensagem da API) — mostrada na tela pra
  // não deixar o dono achando que os números estão atualizados quando não
  // estão. Limpa a cada sync bem-sucedido.
  ultimoErroSync        String?
  // PESSOAL = login do Instagram de uma pessoa (graph.instagram.com).
  // EMPRESA = conta da empresa pelo usuário do sistema do Business Manager
  // (graph.facebook.com): não depende do login de ninguém e é a que o papel
  // Social Media enxerga.
  tipoConexao           String    @default("PESSOAL")
  paginaId              String?
  paginaNome            String?
  // Nova tentativa com backoff exponencial depois de uma falha (5 min, 10,
  // 20... até 6h). Zerado no primeiro sucesso.
  falhasSeguidas        Int       @default(0)
  proximaTentativaEm    DateTime?

  usuario   ProLaboreUsuario            @relation(fields: [usuarioId], references: [id])
  vendedor  Vendedor?                   @relation(fields: [vendedorId], references: [id])
  midias    SocialMediaMidia[]
  snapshots SocialMediaSnapshotDiario[]
  alcancesPeriodo SocialMediaAlcancePeriodo[]
  sincronizacoes  SmSincronizacao[]
  webhookEventos  SmWebhookEvento[]

  @@index([usuarioId])
  @@map("pro_labore_social_media_contas")
}

// Post/reels/carrossel/story sincronizado da conta. Stories só aparecem na
// API enquanto estão no ar (24h) — o sync periódico grava cada uma nesse
// intervalo e ela continua aqui depois que some do Instagram.
model SocialMediaMidia {
  id                     String    @id @default(cuid())
  contaId                String
  instagramMediaId       String    @unique
  tipo                   String // IMAGE | VIDEO | CAROUSEL_ALBUM
  formato                String? // FEED | REELS | STORY | AD (media_product_type)
  legenda                String?
  urlMidia               String?
  thumbnailUrl           String?
  urlPermalink           String?
  publicadoEm            DateTime
  curtidas               Int       @default(0)
  comentarios            Int       @default(0)
  salvamentos            Int       @default(0)
  compartilhamentos      Int       @default(0)
  alcance                Int       @default(0)
  // Legado: "impressions" foi descontinuada pela Meta em abr/2025 — o
  // substituto é `visualizacoes` (views). Mantida só pro histórico antigo.
  impressoes             Int       @default(0)
  visualizacoes          Int       @default(0)
  interacoesTotais       Int       @default(0)
  visitasPerfil          Int       @default(0)
  seguidoresGerados      Int       @default(0)
  respostas              Int       @default(0) // só stories
  tempoMedioAssistidoSeg Float? // só reels
  tempoTotalAssistidoSeg Float? // só reels
  // Seção 3.3: taxa de pulo nos 3 primeiros segundos (reels_skip_rate, 0 a 1),
  // reposts e a duração do vídeo (lida do cabeçalho do MP4; a API não expõe).
  taxaPulo               Float?
  reposts                Int       @default(0)
  duracaoSeg             Float?
  // Navegação de story: { avancos, retornos, saidas, proximoStory }
  navegacaoStory         Json?
  // Cópia própria da miniatura (caminho servido pela API): as URLs da CDN
  // do Instagram expiram e quebravam as imagens da tela (seção 17.8).
  miniaturaLocal         String?
  insightsAtualizadoEm   DateTime?
  atualizadoEm           DateTime  @updatedAt

  conta SocialMediaConta @relation(fields: [contaId], references: [id])

  @@index([contaId, publicadoEm])
  @@map("pro_labore_social_media_midias")
}

// Uma linha por dia por conta — o Instagram não guarda histórico longo de
// métricas de conta (seguidores, alcance diário), então esse snapshot é a
// única forma de montar um gráfico de evolução ao longo do tempo. Gerado
// pelo job de sincronização periódica (cron), não por ação do usuário.
model SocialMediaSnapshotDiario {
  id                    String   @id @default(cuid())
  contaId               String
  data                  DateTime // meia-noite (UTC) do dia do snapshot
  // Total de seguidores no fim do dia — só existe pros dias em que o sync
  // rodou de verdade: a API não devolve o total histórico, então dias
  // reconstruídos pelo backfill (métricas diárias dos últimos 30 dias)
  // ficam sem esse número em vez de ganhar uma estimativa inventada.
  seguidores            Int?
  // Saldo do dia (ganhos - perdidos). Vem da API quando disponível; senão,
  // da diferença entre dois snapshots com `seguidores` preenchido.
  novosSeguidoresDia    Int      @default(0)
  seguidoresGanhosDia   Int      @default(0)
  seguidoresPerdidosDia Int      @default(0)
  alcanceContaDia       Int      @default(0)
  impressoesContaDia    Int      @default(0) // legado — ver SocialMediaMidia.impressoes
  visualizacoesDia      Int      @default(0)
  contasEngajadasDia    Int      @default(0)
  interacoesDia         Int      @default(0)
  curtidasDia           Int      @default(0)
  comentariosDia        Int      @default(0)
  compartilhamentosDia  Int      @default(0)
  salvamentosDia        Int      @default(0)
  respostasDia          Int      @default(0)
  visitasPerfilDia      Int      @default(0)
  toquesLinksDia        Int      @default(0)
  cliquesSiteDia        Int      @default(0)
  publicacoesNoDia      Int      @default(0)
  // O dia foi de fato sincronizado com a API (base do banner de qualidade
  // dos dados e das lacunas). Dia sem linha = lacuna.
  sincronizado          Boolean  @default(true)
  criadoEm              DateTime @default(now())
  atualizadoEm          DateTime @default(now()) @updatedAt

  conta SocialMediaConta @relation(fields: [contaId], references: [id])

  @@unique([contaId, data])
  @@map("pro_labore_social_media_snapshots")
}

// Registro de cada sincronização (manual, de hora em hora, diária ou nova
// tentativa): quando, como terminou e o que fez. Base do cartão da conta
// ("Sincronizado há X min" / "Falha na sincronização") e do histórico.
model SmSincronizacao {
  id          String    @id @default(cuid())
  contaId     String
  job         String // MANUAL | HORA | DIA | RETENTATIVA | CONEXAO
  iniciadoEm  DateTime  @default(now())
  terminadoEm DateTime?
  status      String    @default("RODANDO") // RODANDO | SUCESSO | ERRO
  erro        String?
  resumo      Json?

  conta SocialMediaConta @relation(fields: [contaId], references: [id], onDelete: Cascade)

  @@index([contaId, iniciadoEm])
  @@map("pro_labore_sm_sincronizacoes")
}

// Evento recebido pelo webhook da Meta (comentário, menção, mensagem,
// insights de story que expirou). Guardado como chegou; o Atendimento
// processa em seguida e marca `processadoEm`.
model SmWebhookEvento {
  id           String    @id @default(cuid())
  contaId      String?
  objeto       String // instagram | page
  campo        String // comments | mentions | messages | story_insights | ...
  payload      Json
  recebidoEm   DateTime  @default(now())
  processadoEm DateTime?

  conta SocialMediaConta? @relation(fields: [contaId], references: [id], onDelete: SetNull)

  @@index([processadoEm, recebidoEm])
  @@index([contaId, campo])
  @@map("pro_labore_sm_webhook_eventos")
}

// Aviso para o gestor ou para o Social Media (falha de sincronização,
// pauta para aprovar, venda creditada...). `chave` agrupa avisos repetidos
// do mesmo assunto para não virar barulho: enquanto houver um não lido com
// a mesma chave, o novo só atualiza o existente.
model SmNotificacao {
  id           String    @id @default(cuid())
  usuarioId    String // conta do dono (a operação)
  destinatario String // GESTOR | SOCIAL_MEDIA
  tipo         String // SYNC_FALHA | SYNC_OK | APROVACAO | VENDA | CLIENTE_ESPERANDO | PUBLICACAO_FALHA | ...
  chave        String
  titulo       String
  texto        String
  payload      Json?
  ocorrencias  Int       @default(1)
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @default(now()) @updatedAt
  lidaEm       DateTime?
  enviadaEm    DateTime?

  usuario ProLaboreUsuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, destinatario, lidaEm])
  @@index([chave])
  @@map("pro_labore_sm_notificacoes")
}

// Alcance único (contas distintas) de um período, como o Instagram calcula —
// não é a soma do alcance diário. A API só entrega esse número sob demanda
// (até 30 dias por consulta), então ele fica guardado por período.
model SocialMediaAlcancePeriodo {
  id           String   @id @default(cuid())
  contaId      String
  inicio       DateTime // dia de Brasília (meia-noite UTC)
  fim          DateTime
  alcance      Int
  atualizadoEm DateTime @default(now()) @updatedAt

  conta SocialMediaConta @relation(fields: [contaId], references: [id], onDelete: Cascade)

  @@unique([contaId, inicio, fim])
  @@map("pro_labore_social_media_alcance_periodo")
}

// Assistente comercial de WhatsApp — um por vendedor, ligado ao número que
// ele já usa através de uma sessão "aparelho conectado" (igual ao WhatsApp
// Web), aberta por QR Code ou código de pareamento num servidor Evolution
// API. O número continua funcionando normalmente no celular do vendedor.
// Dois papéis: pré-atendimento de leads novos (roteiro de perguntas → Lead
// no CRM → aviso pro vendedor) e suporte ao próprio vendedor pelo chat
// "Você" (comandos tipo "resumo", "pendentes").
model AssistenteComercial {
  id                    String    @id @default(cuid())
  vendedorId            String    @unique
  // Número conectado (só dígitos, com DDI) — preenchido quando a sessão abre.
  numeroWhatsapp        String?
  nomeExibicao          String?
  // NAO_CONECTADO | AGUARDANDO_QR | CONECTADO | DESCONECTADO (sessão caiu
  // ou foi removida pelo celular — precisa ler o QR de novo)
  status                String    @default("NAO_CONECTADO")
  // Nome da instância no servidor Evolution e segredo que vai na URL do
  // webhook (é o que autentica os eventos que chegam de lá).
  instancia             String?   @unique
  webhookSegredo        String?   @unique
  fotoPerfilUrl         String?
  conectadoEm           DateTime?
  ultimoEventoEm        DateTime?
  // Liga/desliga as respostas automáticas sem derrubar a conexão.
  atendimentoAutomatico Boolean   @default(true)
  // Roteiro e regras (ver ConfigAssistente em lib/assistenteRoteiro.ts).
  configuracao          Json?
  criadoEm              DateTime  @default(now())
  atualizadoEm          DateTime  @updatedAt

  vendedor  Vendedor                    @relation(fields: [vendedorId], references: [id])
  conversas AssistenteConversa[]
  ignorados AssistenteContatoIgnorado[]

  @@map("pro_labore_assistente_comercial")
}

// Uma conversa = um contato falando com o assistente de um vendedor.
// LEAD: contato novo sendo pré-qualificado. SUPORTE: o próprio vendedor
// falando com o assistente pelo chat "Você". Conversas pessoais do vendedor
// nunca viram registro aqui — o conteúdo delas não é guardado.
model AssistenteConversa {
  id                   String    @id @default(cuid())
  assistenteId         String
  tipo                 String // SUPORTE | LEAD
  nomeContato          String
  numeroContato        String // só dígitos, com DDI
  jid                  String? // endereço do chat no WhatsApp (pra responder)
  leadId               String?
  // ATIVA (assistente conduzindo o roteiro) | AGUARDANDO_VENDEDOR (roteiro
  // concluído ou contato pediu atendente) | ASSUMIDA (vendedor respondeu)
  // | ENCERRADA
  status               String    @default("ATIVA")
  // QUALIFICADO | PEDIU_ATENDENTE | DESISTIU | NAO_E_LEAD
  resultado            String?
  // ANUNCIO (clique em anúncio pro WhatsApp) | GATILHO (frase de campanha)
  // | CONTATO_NOVO
  origem               String?
  etapaRoteiro         Int       @default(0)
  respostas            Json?
  ultimaMensagemEm     DateTime  @default(now())
  aguardandoVendedorEm DateTime?
  assumidaEm           DateTime?
  encerradaEm          DateTime?
  criadoEm             DateTime  @default(now())

  assistente AssistenteComercial  @relation(fields: [assistenteId], references: [id])
  lead       Lead?                @relation(fields: [leadId], references: [id])
  mensagens  AssistenteMensagem[]

  @@index([assistenteId])
  @@index([assistenteId, tipo])
  @@index([assistenteId, numeroContato])
  @@map("pro_labore_assistente_conversas")
}

model AssistenteMensagem {
  id         String   @id @default(cuid())
  conversaId String
  remetente  String // CONTATO | ASSISTENTE | VENDEDOR
  texto      String
  // ID da mensagem no WhatsApp — deduplica webhook repetido e separa o que
  // o assistente mandou do que o vendedor digitou no celular.
  providerId String?  @unique
  criadoEm   DateTime @default(now())

  conversa AssistenteConversa @relation(fields: [conversaId], references: [id])

  @@index([conversaId])
  @@map("pro_labore_assistente_mensagens")
}

// Números que o assistente nunca deve responder: contatos com quem o
// vendedor já conversa (detectado quando ele manda mensagem pra um chat que
// não é de lead) ou marcados como "não é lead" no painel. Só o número é
// guardado, nunca o conteúdo da conversa pessoal.
model AssistenteContatoIgnorado {
  id           String   @id @default(cuid())
  assistenteId String
  numero       String
  motivo       String // CONVERSA_PESSOAL | MARCADO_PELO_VENDEDOR
  criadoEm     DateTime @default(now())

  assistente AssistenteComercial @relation(fields: [assistenteId], references: [id])

  @@unique([assistenteId, numero])
  @@map("pro_labore_assistente_contatos_ignorados")
}

// Itens do "plano de ação" do Plano de Crescimento, por pilar. Duas origens:
// SUGERIDA (nasce do motor de regras, ver lib/planoCrescimento.ts) e
// CUSTOMIZADA (o dono escreveu). Uma sugestão persiste com uma `chave`
// estável ("<pilar>:<estagio>:<índice>") pra poder ser marcada como
// concluída e continuar reconhecida entre uma carga e outra, mesmo que o
// texto mude (várias ações têm números ao vivo interpolados, tipo "ROAS
// atual de 2.4x"). Se o dono editar o texto manualmente, `editadoManualmente`
// trava esse texto — carregar a página de novo não sobrescreve o que ele
// escreveu. Quando o pilar muda de estágio, a chave muda junto (estágio faz
// parte dela), então sugestões de um estágio anterior somem da tela sozinhas
// sem precisar apagar nada — ver o filtro em GET /plano-crescimento.
model PlanoCrescimentoAcao {
  id                 String   @id @default(cuid())
  usuarioId          String
  pilar              String // aquisicao | conversao | execucao | financeiro
  chave              String? // só em origem SUGERIDA — nulo em CUSTOMIZADA
  texto              String
  concluida          Boolean  @default(false)
  origem             String   @default("CUSTOMIZADA") // SUGERIDA | CUSTOMIZADA
  editadoManualmente Boolean  @default(false)
  criadoEm           DateTime @default(now())
  atualizadoEm       DateTime @updatedAt

  usuario ProLaboreUsuario @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, chave])
  @@index([usuarioId, pilar])
  @@map("pro_labore_plano_crescimento_acoes")
}

// Uma linha por mês, com o estágio de cada pilar naquele momento — grava
// (upsert) toda vez que GET /plano-crescimento roda, então o mês corrente
// sempre reflete o dado mais recente; meses passados congelam assim que o
// mês vira, porque o upsert seguinte já mira a chave de um mês novo. É o
// que alimenta a grade de evolução mensal na tela.
model PlanoCrescimentoSnapshot {
  id                String   @id @default(cuid())
  usuarioId         String
  mesReferencia     DateTime
  estagioGeral      String
  estagioAquisicao  String
  estagioConversao  String
  estagioExecucao   String
  estagioFinanceiro String
  criadoEm          DateTime @default(now())
  atualizadoEm      DateTime @updatedAt

  usuario ProLaboreUsuario @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, mesReferencia])
  @@map("pro_labore_plano_crescimento_snapshots")
}

// Reuniões, aulas e vídeos que o usuário quer manter registrados — a
// transcrição automática por IA ainda não está integrada (exigiria uma API
// paga de terceiro, tipo Whisper), então `transcricao` por enquanto é
// digitada/colada manualmente; o campo já existe pronto pra receber o texto
// gerado automaticamente quando essa integração for feita, sem migrar nada.
// Estritamente pessoal: `vendedorId` (nulo pro dono) identifica o dono do
// registro, e ninguém enxerga o de outra pessoa — mesmo o dono não vê as
// reuniões de um vendedor, porque isso aqui é bloco pessoal, não dado de
// operação (ver reuniaoWhereBase em routes/proLabore.ts).
model Reuniao {
  id                  String   @id @default(cuid())
  usuarioId           String
  vendedorId          String?
  titulo              String
  tipo                String   @default("REUNIAO") // REUNIAO | AULA | VIDEO | OUTRO
  data                DateTime @default(now())
  duracaoSegundos     Int?
  nomeArquivoOriginal String?
  transcricao         String?
  criadoEm            DateTime @default(now())
  atualizadoEm        DateTime @updatedAt

  usuario ProLaboreUsuario @relation(fields: [usuarioId], references: [id])
  notas   Nota[]

  @@index([usuarioId, vendedorId])
  @@map("pro_labore_reunioes")
}

// Anotações livres (trabalho/ideia/aprendizado/outro) — soltas ou
// vinculadas a uma Reuniao específica (`reuniaoId` opcional). Mesma
// privacidade estrita de Reuniao.
model Nota {
  id           String   @id @default(cuid())
  usuarioId    String
  vendedorId   String?
  reuniaoId    String?
  pastaId      String?
  titulo       String?
  conteudo     String
  // Conteúdo "de verdade" da página, no formato editor de blocos (título,
  // lista, checkbox, citação, código, divisor — ver EditorBlocos no
  // frontend). Nulo pra notas antigas, criadas antes dessa funcionalidade;
  // nesse caso a tela monta um bloco único de parágrafo a partir de
  // `conteudo` na primeira abertura. `conteudo` continua existindo como
  // texto puro derivado dos blocos — serve pro preview/snippet na listagem
  // sem precisar interpretar o JSON toda hora.
  blocos       Json?
  icone        String? // emoji, opcional — página sem ícone usa o ícone padrão
  categoria    String   @default("TRABALHO") // TRABALHO | IDEIA | APRENDIZADO | OUTRO
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuario ProLaboreUsuario @relation(fields: [usuarioId], references: [id])
  reuniao Reuniao?         @relation(fields: [reuniaoId], references: [id])
  pasta   Pasta?           @relation(fields: [pastaId], references: [id])

  @@index([usuarioId, vendedorId])
  @@index([reuniaoId])
  @@index([pastaId])
  @@map("pro_labore_notas")
}

// Organização livre das Anotações em árvore — o usuário pode chamar de
// pasta, departamento, módulo, o que fizer sentido pra ele; pro sistema é
// só um container que pode ter outros containers dentro (`paiId` aninha
// livremente). Excluir uma pasta não apaga o que está dentro: subpastas e
// notas soltam pro nível de cima (`paiId`/`pastaId` viram nulos), porque
// perder conteúdo silenciosamente numa exclusão de pasta seria pior que
// só desorganizar.
model Pasta {
  id           String   @id @default(cuid())
  usuarioId    String
  vendedorId   String?
  nome         String
  icone        String? // emoji, opcional — pasta sem ícone usa o ícone padrão
  paiId        String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuario      ProLaboreUsuario @relation(fields: [usuarioId], references: [id])
  pai          Pasta?           @relation("PastaFilhas", fields: [paiId], references: [id])
  subpastas    Pasta[]          @relation("PastaFilhas")
  notas        Nota[]
  mapasMentais MapaMental[]

  @@index([usuarioId, vendedorId])
  @@index([paiId])
  @@map("pro_labore_pastas")
}

// Mapa mental / board: outro "tipo de página" dentro da mesma árvore de
// Anotações (mora dentro de uma Pasta como uma Nota, só que abre um canvas
// em vez do editor de blocos). Guardava só uma árvore de nós (`raiz`,
// recursivo { id, texto, filhos: [...] }); virou um board genérico com
// `objetos`/`conectores` planos (array de BoardObjeto/BoardConector — ver
// tipos em MapaMental.tsx no frontend), que suporta formas soltas
// conectadas livremente, não só uma hierarquia de ideias. `raiz` continua
// existindo só pra mapas antigos que nunca foram salvos no formato novo —
// o frontend converte a árvore pra objetos/conectores na primeira abertura
// e passa a salvar só no formato novo dali em diante; nunca é escrito de
// novo depois da migração, então não precisa ficar em sincronia com
// objetos/conectores.
model MapaMental {
  id           String    @id @default(cuid())
  usuarioId    String
  vendedorId   String?
  pastaId      String?
  titulo       String?
  icone        String? // emoji, opcional — mapa sem ícone usa o ícone padrão
  tema         String? // tema visual do canvas (fundo/pontilhado) — null = tema padrão ("claro")
  // Layout persistente + paleta de cor dos ramos + alinhamento automático
  // (painel "Aparência", estilo MindMeister): { layout, alinhamentoAutomatico, paleta }.
  // Null = tudo no padrão de sempre (layout manual, paleta "meister").
  configuracao Json?
  raiz         Json?
  objetos      Json?
  conectores   Json?
  // Lixeira (soft delete): "excluir" move pra lixeira (seta excluidoEm),
  // só um segundo "excluir definitivamente" (a partir da própria lixeira)
  // realmente apaga a linha — evita apagar sem querer um mapa mental
  // inteiro, mesmo erro custa mais caro aqui do que numa nota de texto.
  excluidoEm   DateTime?
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  usuario ProLaboreUsuario   @relation(fields: [usuarioId], references: [id])
  pasta   Pasta?             @relation(fields: [pastaId], references: [id])
  versoes MapaMentalVersao[]

  @@index([usuarioId, vendedorId])
  @@index([pastaId])
  @@index([excluidoEm])
  @@map("pro_labore_mapas_mentais")
}

// Histórico de versões (6.12 do mapeamento) — snapshot do board ANTES de
// cada atualização relevante (não depois: assim sempre dá pra voltar pro
// estado anterior ao que está salvo agora), com throttle de tempo mínimo
// entre snapshots pra não criar uma linha nova a cada debounce de autosave
// (ver THROTTLE_VERSAO_MS na rota) e um teto de quantidade retida por board.
model MapaMentalVersao {
  id           String   @id @default(cuid())
  mapaMentalId String
  objetos      Json?
  conectores   Json?
  criadoEm     DateTime @default(now())

  mapaMental MapaMental @relation(fields: [mapaMentalId], references: [id], onDelete: Cascade)

  @@index([mapaMentalId, criadoEm])
  @@map("pro_labore_mapas_mentais_versoes")
}

// Apresentação ao vivo (aba Reuniões): o dono monta um mapa mental (mesmo
// motor da aba Anotações) e a equipe assiste em tempo real, só leitura.
// Fica guardada depois, com anotações, lembretes e notas privadas.
// `versao` sobe a cada mudança do conteúdo compartilhado; `palco` é o
// estado efêmero da transmissão (enquadramento da tela, nó selecionado,
// ponteiro laser) com a própria `palcoVersao` — separado pra o ponteiro,
// que muda várias vezes por segundo, não reenviar o mapa inteiro.
model Apresentacao {
  id                  String    @id @default(cuid())
  usuarioId           String
  titulo              String
  descricao           String?
  icone               String?
  // Árvore do motor de mapa mental: { id, text, children, collapsed }.
  arvore              Json
  // { layout: 'mind'|'org'|'list', tema, doisLados }
  configuracao        Json?
  // Blocos (mesmo formato do editor de Anotações), visíveis pra equipe.
  notas               Json?
  // Só o dono vê — roteiro/lembretes de quem apresenta.
  notasPrivadas       String?
  // [{ id, texto, feito, data? }] — visíveis pra equipe.
  lembretes           Json?
  visivelEquipe       Boolean   @default(true)
  // Quem montou: null = dono da conta; "vendedor:<id>" = alguém da equipe
  // (só apresenta com autorização — ver ReuniaoPermissao).
  autorPessoa         String?
  autorNome           String?
  // RASCUNHO | PENDENTE | APROVADA | RECUSADA. Só APROVADA aparece pra
  // equipe e pode ir ao vivo; as do dono já nascem APROVADA.
  aprovacao           String    @default("APROVADA")
  aprovacaoMotivo     String?
  pedidoEm            DateTime?
  // Organização: departamento (protegido por senha) e pasta. Os dois nulos
  // = "Geral", aberto pra equipe toda.
  departamentoId      String?
  pastaId             String?
  versao              Int       @default(0)
  palco               Json?
  palcoVersao         Int       @default(0)
  aoVivo              Boolean   @default(false)
  aoVivoDesde         DateTime?
  apresentadorSinalEm DateTime?
  criadoEm            DateTime  @default(now())
  atualizadoEm        DateTime  @updatedAt

  usuario      ProLaboreUsuario         @relation(fields: [usuarioId], references: [id])
  departamento ReuniaoDepartamento?     @relation(fields: [departamentoId], references: [id], onDelete: Restrict)
  pasta        ReuniaoPasta?            @relation(fields: [pastaId], references: [id], onDelete: SetNull)
  espectadores ApresentacaoEspectador[]
  notasPessoais ApresentacaoNotaPessoal[]

  @@index([usuarioId])
  @@index([departamentoId])
  @@index([usuarioId, aprovacao])
  @@map("pro_labore_apresentacoes")
}

// Departamento das reuniões (ex.: Vendas, Pós-venda, Gestão): só entra quem
// sabe a senha. A senha é guardada com hash; trocar a senha sobe
// `senhaVersao` e derruba o acesso de todo mundo que já tinha entrado.
model ReuniaoDepartamento {
  id           String   @id @default(cuid())
  usuarioId    String
  nome         String
  descricao    String?
  cor          String   @default("#5b8def")
  senhaHash    String
  senhaVersao  Int      @default(1)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuario       ProLaboreUsuario            @relation(fields: [usuarioId], references: [id])
  pastas        ReuniaoPasta[]
  apresentacoes Apresentacao[]
  acessos       ReuniaoDepartamentoAcesso[]

  @@index([usuarioId])
  @@map("pro_labore_reunioes_departamentos")
}

// Pasta pra separar as apresentações — dentro de um departamento ou no
// "Geral" (departamentoId nulo), e dentro de outra pasta (paiId). Excluir a
// pasta não apaga nada: subpastas e apresentações sobem um nível.
model ReuniaoPasta {
  id             String   @id @default(cuid())
  usuarioId      String
  departamentoId String?
  paiId          String?
  nome           String
  criadoEm       DateTime @default(now())

  usuario       ProLaboreUsuario     @relation(fields: [usuarioId], references: [id])
  departamento  ReuniaoDepartamento? @relation(fields: [departamentoId], references: [id], onDelete: Cascade)
  pai           ReuniaoPasta?        @relation("ReuniaoPastaFilhas", fields: [paiId], references: [id], onDelete: SetNull)
  filhas        ReuniaoPasta[]       @relation("ReuniaoPastaFilhas")
  apresentacoes Apresentacao[]

  @@index([usuarioId, departamentoId])
  @@map("pro_labore_reunioes_pastas")
}

// Quem já digitou a senha certa do departamento ("dono:<id>" ou
// "vendedor:<id>"). Vale enquanto `senhaVersao` bater com a do departamento.
model ReuniaoDepartamentoAcesso {
  id             String   @id @default(cuid())
  departamentoId String
  pessoa         String
  senhaVersao    Int
  liberadoEm     DateTime @default(now())

  departamento ReuniaoDepartamento @relation(fields: [departamentoId], references: [id], onDelete: Cascade)

  @@unique([departamentoId, pessoa])
  @@map("pro_labore_reunioes_departamentos_acessos")
}

// Quem está assistindo (ou assistiu) — `pessoa` é "dono:<id>" ou
// "vendedor:<id>". `ultimoSinalEm` é renovado pela conexão ao vivo; quem
// não dá sinal há mais de ~40s deixa de contar como "assistindo agora".
model ApresentacaoEspectador {
  id             String   @id @default(cuid())
  apresentacaoId String
  pessoa         String
  nome           String
  entrouEm       DateTime @default(now())
  ultimoSinalEm  DateTime @default(now())

  apresentacao Apresentacao @relation(fields: [apresentacaoId], references: [id], onDelete: Cascade)

  @@unique([apresentacaoId, pessoa])
  @@map("pro_labore_apresentacoes_espectadores")
}

// Quem da equipe pode apresentar na aba Reuniões. Sem linha = APROVACAO
// (monta à vontade, mas cada apresentação passa pelo dono antes de a
// equipe ver). LIVRE = apresenta sem pedir. BLOQUEADO = nem monta.
model ReuniaoPermissao {
  id           String   @id @default(cuid())
  usuarioId    String
  // "vendedor:<id>"
  pessoa       String
  modo         String
  atualizadoEm DateTime @updatedAt

  @@unique([usuarioId, pessoa])
  @@map("pro_labore_reunioes_permissoes")
}

// "Só pra mim" de quem assiste: cada pessoa da equipe tem a sua nota,
// que nem o dono nem os colegas veem. (A do dono fica em notasPrivadas.)
model ApresentacaoNotaPessoal {
  id             String   @id @default(cuid())
  apresentacaoId String
  // "dono:<id>" | "vendedor:<id>"
  pessoa         String
  texto          String
  atualizadoEm   DateTime @updatedAt

  apresentacao Apresentacao @relation(fields: [apresentacaoId], references: [id], onDelete: Cascade)

  @@unique([apresentacaoId, pessoa])
  @@map("pro_labore_apresentacoes_notas_pessoais")
}

// ---------- Tráfego (Gerenciador de Anúncios da Meta) ----------

// Conta de anúncios conectada (uma por conta do sistema). O token é de um
// usuário do sistema do Gerenciador de Negócios (não expira) ou de uma
// pessoa (expira em ~60 dias) — nunca sai pro frontend.
model TrafegoConta {
  id                    String    @id @default(cuid())
  usuarioId             String    @unique
  adAccountId           String // "act_123..."
  nome                  String
  moeda                 String    @default("BRL")
  fuso                  String?
  accessToken           String
  conectadoEm           DateTime  @default(now())
  ultimaSincronizacaoEm DateTime?
  ultimoErroSync        String?
  // Até onde o histórico já foi puxado (a carga inicial vem em partes pra
  // caber no tempo da função).
  historicoDesde        DateTime?
  // Etapas do funil que aparecem (null = automático, pelas que têm dado),
  // metas por etapa e se "Leads no CRM" conta só os marcados como Tráfego.
  configuracao          Json?
  // Versão do formato dos insights guardados: quando sobe (métricas novas),
  // o histórico é puxado de novo.
  versaoDados           Int       @default(1)
  // Última leitura de campanhas/conjuntos/anúncios (status, orçamento,
  // público, criativo).
  estruturaEm           DateTime?
  // Tipos de ação que a Meta mandou nos últimos dias, com o total de cada
  // ({ desde, ate, totais }) — pra saber quais métricas a conta tem.
  acoesMeta             Json?
  atualizadoEm          DateTime  @updatedAt

  insights TrafegoInsightDiario[]

  @@map("pro_labore_trafego_contas")
}

// Métricas de um anúncio num dia (data do fuso da conta de anúncios). A
// campanha/conjunto/conta são somados a partir daqui — menos alcance e
// frequência, que não somam (ver TrafegoAlcance).
model TrafegoInsightDiario {
  id            String   @id @default(cuid())
  contaId       String
  data          DateTime @db.Date
  adId          String
  adNome        String
  adsetId       String
  adsetNome     String
  campanhaId    String
  campanhaNome  String
  objetivo      String?
  gasto         Float    @default(0)
  impressoes    Int      @default(0)
  alcance       Int      @default(0)
  cliques       Int      @default(0)
  cliquesLink   Int      @default(0)
  lpv           Int      @default(0)
  conversas     Int      @default(0)
  leads         Int      @default(0)
  videoViews    Int      @default(0)
  thruplays     Int      @default(0)
  videoP25      Int      @default(0)
  videoP50      Int      @default(0)
  videoP75      Int      @default(0)
  videoP100     Int      @default(0)
  videoP95      Int      @default(0)
  videoPlays    Int      @default(0)
  // Soma de (tempo médio assistido × reproduções), em segundos: dividida
  // pelas reproduções do período dá o tempo médio.
  videoTempoTotal Float  @default(0)
  cliquesSaida  Int      @default(0)
  engajamento   Int      @default(0)
  reacoes       Int      @default(0)
  comentarios   Int      @default(0)
  compartilhamentos Int  @default(0)
  salvamentos   Int      @default(0)
  // Conversas em que a pessoa mandou 2, 3 e 5+ mensagens; e bloqueios.
  conversasProf2 Int     @default(0)
  conversasProf3 Int     @default(0)
  conversasProf5 Int     @default(0)
  bloqueios     Int      @default(0)
  atualizadoEm  DateTime @updatedAt

  conta TrafegoConta @relation(fields: [contaId], references: [id], onDelete: Cascade)

  @@unique([contaId, data, adId])
  @@index([contaId, data])
  @@map("pro_labore_trafego_insights")
}

// Alcance/frequência de um período (conta inteira ou por campanha): não dá
// pra somar dias, então vem da própria Meta pro período pedido e fica
// guardado um tempo pra não chamar a API a cada abertura da aba.
model TrafegoAlcance {
  id           String   @id @default(cuid())
  contaId      String
  inicio       DateTime @db.Date
  fim          DateTime @db.Date
  // "conta" ou o id da campanha
  chave        String
  alcance      Int
  frequencia   Float
  atualizadoEm DateTime @updatedAt

  @@unique([contaId, inicio, fim, chave])
  @@map("pro_labore_trafego_alcance")
}

// Campanhas, conjuntos e anúncios como estão agora no Gerenciador: status,
// orçamento, otimização, público (resumo do direcionamento), fase de
// aprendizado, criativo (miniatura, texto, chamada) e ranking de qualidade.
model TrafegoEstrutura {
  id           String   @id @default(cuid())
  contaId      String
  tipo         String // campanha | conjunto | anuncio
  objetoId     String
  nome         String
  status       String?
  dados        Json
  atualizadoEm DateTime @updatedAt

  @@unique([contaId, tipo, objetoId])
  @@index([contaId, tipo])
  @@map("pro_labore_trafego_estrutura")
}

// Quebras por público de um período (idade/gênero, região, posicionamento,
// dispositivo, horário), no nível de conjunto — o filtro de campanha/
// conjunto é aplicado na hora. Vem da Meta sob demanda e fica guardado.
model TrafegoPublicoCache {
  id           String   @id @default(cuid())
  contaId      String
  inicio       DateTime @db.Date
  fim          DateTime @db.Date
  tipo         String
  linhas       Json
  atualizadoEm DateTime @updatedAt

  @@unique([contaId, inicio, fim, tipo])
  @@map("pro_labore_trafego_publicos")
}

// Imagens enviadas pra dentro dos mapas mentais (o arquivo original, até
// 4 MB; só as maiores chegam reduzidas pelo navegador). Servidas por GET público pela `chave` (aleatória, longa):
// a tag <img> não manda o token de login.
model ImagemUpload {
  id        String   @id @default(cuid())
  chave     String   @unique
  usuarioId String
  mime      String
  dados     Bytes
  tamanho   Int
  criadoEm  DateTime @default(now())

  @@index([usuarioId])
  @@map("pro_labore_imagens")
}

// Preferências de cada pessoa que usa o Pró-Labore (dono ou alguém da
// equipe): ex. a formatação padrão das ideias nos mapas mentais.
model PreferenciaProLabore {
  id           String   @id @default(cuid())
  usuarioId    String
  // "dono:<id>" ou "vendedor:<id>" (mesma chave das apresentações)
  pessoa       String
  dados        Json
  atualizadoEm DateTime @updatedAt

  @@unique([usuarioId, pessoa])
  @@map("pro_labore_preferencias")
}

// Responsável pelo papel Social Media (seção 3.1 da especificação). Um por
// operação: entra pelo convite da tela 07, define a própria senha e loga na
// mesma tela do Pró-Labore. O token dele só abre as rotas /pro-labore/sm/*.
model SmMembro {
  id               String    @id @default(cuid())
  usuarioId        String    @unique // conta do dono (a operação)
  nome             String
  tratamento       String? // como a saudação chama a pessoa
  email            String    @unique
  senhaHash        String?
  ativo            Boolean   @default(true)
  conviteHash      String?   @unique // sha256 do token do link; o token em si nunca fica no banco
  conviteExpiraEm  DateTime?
  convidadoEm      DateTime  @default(now())
  ativadoEm        DateTime?
  primeiroAcessoEm DateTime?
  ultimoAcessoEm   DateTime?
  criadoEm         DateTime  @default(now())
  atualizadoEm     DateTime  @updatedAt

  usuario ProLaboreUsuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("pro_labore_sm_membros")
}

// O que o papel Social Media enxerga (tela 07): nível por módulo e as quatro
// regras. `niveis` guarda só o que o gestor mudou; o resto vem do padrão da
// seção 3.1 (lib/smAcesso.ts).
model SmPermissao {
  id               String   @id @default(cuid())
  usuarioId        String   @unique
  niveis           Json     @default("{}")
  aprovacaoGestor  Boolean  @default(true)
  mostrarValores   Boolean  @default(true)
  relatorioSemanal Boolean  @default(true)
  assistenteIA     Boolean  @default(false)
  atualizadoEm     DateTime @default(now()) @updatedAt

  usuario ProLaboreUsuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("pro_labore_sm_permissoes")
}

// Estoque leve do Social Media (decisão P3): só o que a produção de
// conteúdo precisa — modelo, ano, cor e há quantos dias está na loja.
// Nunca guarda custo nem margem. Mantido pelo gestor.
model SmMotoEstoque {
  id           String    @id @default(cuid())
  usuarioId    String
  modelo       String
  marca        String?
  ano          Int?
  cor          String?
  entradaEm    DateTime
  situacao     String    @default("DISPONIVEL") // DISPONIVEL | RESERVADA | VENDIDA
  saidaEm      DateTime?
  observacao   String?
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  usuario ProLaboreUsuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  pautas  SmPauta[]

  @@index([usuarioId, situacao])
  @@map("pro_labore_sm_motos_estoque")
}

// Pauta de conteúdo (tela 03 · Produção): da ideia à publicação pela API.
model SmPauta {
  id                    String    @id @default(cuid())
  usuarioId             String
  titulo                String
  pilar                 String // ESTOQUE | PROVA | EDUCACAO | BASTIDORES
  formato               String // REELS | CARROSSEL | FOTO | STORY
  status                String    @default("IDEIA") // IDEIA | ROTEIRO | GRAVACAO | EDICAO | APROVACAO | AGENDADO | PUBLICADO
  ordem                 Float     @default(0)
  prazo                 DateTime?
  origem                String    @default("MANUAL") // MANUAL | ESTOQUE | VENDA | INSIGHT | AUDIENCIA | CALENDARIO
  origemRef             String? // o que gerou a pauta (moto, venda, insight): evita sugerir duas vezes
  motoId                String?
  gancho                String?
  retencao              String?
  recompensa            String?
  cta                   String?
  legenda               String?
  checklist             Json      @default("{}") // itens marcados à mão (ex.: capaTexto)
  agendadoPara          DateTime?
  codigo                String? // #P-DDMM-MODELO (stories: #S-...), gerado quando a pauta ganha data
  trial                 Boolean   @default(false) // publicar como Trial Reel
  aprovacao             String? // PENDENTE | APROVADA | AJUSTE
  enviadaAprovacaoEm    DateTime?
  aprovadaEm            DateTime?
  comentarioAprovacao   String?
  publicacaoStatus      String? // AGUARDANDO | PROCESSANDO | PUBLICADA | FALHA
  publicacaoContainerId String?
  publicacaoErro        String?
  publicacaoTentativas  Int       @default(0)
  publicadaEm           DateTime?
  igMediaId             String?
  permalink             String?
  autorizacaoImagem     Boolean   @default(false) // decisão P6: entregas com cliente
  // Teste A/B (seção 13.3): a pauta entra num grupo do teste.
  testeId               String?
  testeGrupo            String? // A | B
  criadoPor             String    @default("SOCIAL_MEDIA") // SOCIAL_MEDIA | GESTOR
  criadoEm              DateTime  @default(now())
  atualizadoEm          DateTime  @updatedAt

  usuario ProLaboreUsuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  moto    SmMotoEstoque?   @relation(fields: [motoId], references: [id], onDelete: SetNull)
  midias  SmPautaMidia[]
  teste   SmTeste?         @relation(fields: [testeId], references: [id], onDelete: SetNull)

  @@unique([usuarioId, codigo])
  @@index([usuarioId, status])
  @@index([usuarioId, agendadoPara])
  @@index([motoId])
  @@index([testeId])
  @@map("pro_labore_sm_pautas")
}

// Arquivos da pauta: imagens enviadas (armazenamento próprio), vídeo por
// link público e o termo de autorização de imagem.
model SmPautaMidia {
  id       String   @id @default(cuid())
  pautaId  String
  tipo     String // IMAGEM | VIDEO | CAPA | TERMO
  url      String
  ordem    Int      @default(0)
  criadoEm DateTime @default(now())

  pauta SmPauta @relation(fields: [pautaId], references: [id], onDelete: Cascade)

  @@index([pautaId])
  @@map("pro_labore_sm_pautas_midias")
}

// Regras de cadência e metas do calendário (seção 5), configuráveis pelo
// gestor. Padrões da especificação: 4 dias com post por semana, até 2 posts
// por dia, no máximo 2 dias seguidos sem post e o mix 40/20/25/15.
model SmConfig {
  id              String   @id @default(cuid())
  usuarioId       String   @unique
  minDiasSemana   Int      @default(4)
  maxPostsDia     Int      @default(2)
  maxDiasSemPost  Int      @default(2)
  mixMeta         Json     @default("{\"ESTOQUE\":40,\"PROVA\":20,\"EDUCACAO\":25,\"BASTIDORES\":15}")
  horizonteDias   Int      @default(21) // até onde o calendário oferece "+ slot livre"
  // Metas da semana da tela Hoje (seção 4); todas editáveis pelo gestor.
  metaLeadsSemana Int      @default(10)
  metaRespostaMin Int      @default(15) // tempo de resposta a DMs, em minutos
  metaRetencao    Int      @default(45) // retenção média dos reels, em %
  // Metas dos sinais da tela 05 · Desempenho (seção 12), editáveis pelo gestor.
  metaPuloPct     Int      @default(40) // pulo nos 3 s, em % (abaixo é melhor)
  metaEnviosMil   Float    @default(3) // envios por mil alcançados
  metaSalvosMil   Float    @default(3) // salvos por mil alcançados
  metaCurtidasPct Float    @default(3) // curtidas por alcance, em %
  // Expediente (decisão P13): fora dele, a automação de resposta avisa o cliente.
  expedienteInicio Int     @default(8)
  expedienteFim    Int     @default(18)
  expedienteDias   String  @default("1,2,3,4,5") // 0 = domingo
  // Rodízio dos leads do Social Media (decisão P4): o último consultor que recebeu.
  rodizioUltimoVendedorId String?
  // WhatsApp da loja (decisão P9): destino do link rastreado /r/{code}.
  whatsappLoja    String?
  atualizadoEm    DateTime @default(now()) @updatedAt

  usuario ProLaboreUsuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("pro_labore_sm_config")
}

// Conversa do Atendimento (tela 04): direct (uma por cliente) ou fio de
// comentário (uma por comentário raiz). Chega pelo webhook da Meta.
model SmConversa {
  id              String    @id @default(cuid())
  usuarioId       String
  canal           String // DIRECT | COMENTARIO | COMENTARIO_AUTOMACAO | RESPOSTA_STORY
  chave           String // direct: id do cliente (IGSID); comentário: id do comentário raiz
  clienteIgId     String
  clienteNome     String?
  clienteUsuario  String?
  midiaIgId       String? // post (ou story) de origem
  postCode        String?
  postTitulo      String?
  motoInteresse   String?
  comentarioIgId  String? // fio do comentário (para responder)
  status          String    @default("ABERTA") // ABERTA | RESPONDIDA | LEAD | ARQUIVADA
  ultimaMsgEm     DateTime
  ultimaEntradaEm DateTime? // última mensagem do cliente (janela de 24 h)
  aguardandoDesde DateTime? // primeira mensagem do cliente ainda sem resposta humana
  foraHorarioEm   DateTime? // última resposta automática de fora do expediente
  leadId          String?
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt

  usuario   ProLaboreUsuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  mensagens SmMensagem[]

  @@unique([usuarioId, canal, chave])
  @@index([usuarioId, aguardandoDesde])
  @@index([usuarioId, ultimaMsgEm])
  @@map("pro_labore_sm_conversas")
}

model SmMensagem {
  id           String   @id @default(cuid())
  conversaId   String
  direcao      String // IN | OUT
  autor        String // CLIENTE | HUMANO | AUTOMACAO
  automacao    String? // PALAVRA_CHAVE | FORA_HORARIO
  texto        String
  igMensagemId String?  @unique
  respostaMin  Float? // 1ª resposta humana: minutos desde a mensagem que esperava
  enviadaEm    DateTime @default(now())

  conversa SmConversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  @@index([conversaId, enviadaEm])
  @@map("pro_labore_sm_mensagens")
}

// Automações do Atendimento: "Comente QUERO" (palavra-chave em comentário
// manda a ficha da moto no direct) e resposta fora do expediente.
model SmAutomacao {
  id        String   @id @default(cuid())
  usuarioId String
  tipo      String // PALAVRA_CHAVE | FORA_HORARIO
  palavra   String?
  resposta  String
  ativa     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  usuario ProLaboreUsuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, tipo])
  @@map("pro_labore_sm_automacoes")
}

model SmRespostaRapida {
  id        String @id @default(cuid())
  usuarioId String
  titulo    String
  texto     String
  ordem     Int    @default(0)

  usuario ProLaboreUsuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, ordem])
  @@map("pro_labore_sm_respostas_rapidas")
}

// Link rastreado (seção 3.5): /r/{slug} registra o toque e abre o WhatsApp
// da loja com a mensagem que traz o código do post. O slug é curto e único
// no sistema todo (a rota é pública); o código é o da pauta (#P-, #S-) ou #BIO.
model SmLinkRastreado {
  id         String   @id @default(cuid())
  usuarioId  String
  slug       String   @unique
  codigo     String
  tipo       String // POST | STORY | BIO
  pautaId    String?  @unique
  titulo     String?
  mensagem   String
  cliques    Int      @default(0)
  criadoEm   DateTime @default(now())

  usuario ProLaboreUsuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  toques  SmLinkClique[]

  @@unique([usuarioId, codigo])
  @@map("pro_labore_sm_links")
}

// Cada toque no link (para filtrar por período). O visitante é um hash
// de IP + navegador, sem guardar o dado em si, só para não contar o mesmo
// toque repetido em poucos minutos.
model SmLinkClique {
  id        String   @id @default(cuid())
  linkId    String
  visitante String
  em        DateTime @default(now())

  link SmLinkRastreado @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, em])
  @@map("pro_labore_sm_links_cliques")
}

// Teste A/B (seção 13.3): hipótese, variável, dois grupos e a amostra alvo
// (padrão 6, 3 por grupo). Os posts entram pela Produção ou pelo Calendário;
// o resultado só é declarado com a amostra completa.
model SmTeste {
  id          String    @id @default(cuid())
  usuarioId   String
  hipotese    String
  descricao   String?
  variavel    String // HORARIO | GANCHO | FORMATO | CTA | OUTRO
  grupoA      String
  grupoB      String
  horaA       Int? // testes de horário: a hora de cada grupo (marca "Em teste" nas melhores janelas)
  horaB       Int?
  metrica     String    @default("ALCANCE") // ALCANCE | ENVIOS | SALVOS | PULO | RETENCAO
  amostraAlvo Int       @default(6)
  status      String    @default("ATIVO") // ATIVO | CONCLUIDO | CANCELADO
  resultado   Json?
  vencedor    String? // A | B | EMPATE
  confianca   String? // alta | media | baixa | hipotese
  origem      String    @default("MANUAL") // MANUAL | INSIGHT
  origemRef   String?
  criadoPor   String    @default("SOCIAL_MEDIA")
  criadoEm    DateTime  @default(now())
  concluidoEm DateTime?

  usuario ProLaboreUsuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  pautas  SmPauta[]

  @@index([usuarioId, status])
  @@map("pro_labore_sm_testes")
}

// Biblioteca de ganchos (seção 3.4): o texto e os reels que o usaram; o
// pulo médio sai das métricas desses reels, nunca é digitado.
model SmGancho {
  id        String   @id @default(cuid())
  usuarioId String
  texto     String
  chave     String // texto normalizado (sem acento, minúsculo) para não duplicar
  exemplos  String[] @default([]) // ids das mídias no Instagram
  criadoPor String   @default("SOCIAL_MEDIA")
  criadoEm  DateTime @default(now())

  usuario ProLaboreUsuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, chave])
  @@map("pro_labore_sm_ganchos")
}
