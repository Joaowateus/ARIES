# Copiar para .env no servidor de produção e preencher os valores reais

# Banco PostgreSQL (Neon, Supabase, Railway PostgreSQL, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/aries?sslmode=require"

# JWT — gerar com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="GERAR_NOVO_SECRET_64_BYTES_HEX"

# Porta da API (Railway define automaticamente via $PORT)
PORT=3001

# Ambiente
NODE_ENV=production

# URL do frontend em produção (sem barra no final)
FRONTEND_URL=https://app.ariesnegocios.com.br

# Log level em produção
LOG_LEVEL=info

# Cifra dos tokens salvos no banco (integrações de anúncio) — gerar com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRACOES_SECRET_KEY="GERAR_NOVO_SECRET_32_BYTES_HEX"

# Integração Meta Ads (Funil de Tráfego Pago) — criar o app em
# https://developers.facebook.com/apps, produto Marketing API.
# META_REDIRECT_URI precisa ser https://api.ariesnegocios.com.br/integracoes/meta-ads/callback (ajustar domínio)
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="https://api.ariesnegocios.com.br/integracoes/meta-ads/callback"
