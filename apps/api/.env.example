# Copie este arquivo para .env e preencha os valores

# Banco de dados PostgreSQL
# Local: postgresql://aries:aries2026dev@localhost:5432/aries
# Neon:  postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/aries?sslmode=require
# Supabase: postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
DATABASE_URL="postgresql://..."

# Segredo JWT — use uma string longa e aleatória em produção
JWT_SECRET="mude-para-um-segredo-longo-e-aleatorio"

PORT=3001
NODE_ENV=production
FRONTEND_URL=https://seu-dominio.com.br

# Cifra dos tokens salvos no banco (integrações de anúncio) — gerar com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRACOES_SECRET_KEY="mude-para-um-segredo-longo-e-aleatorio"

# Integração Meta Ads (Funil de Tráfego Pago) — criar o app em
# https://developers.facebook.com/apps, produto Marketing API.
# META_REDIRECT_URI precisa ser a URL pública desta API + /integracoes/meta-ads/callback
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="https://sua-api.seu-dominio.com.br/integracoes/meta-ads/callback"
