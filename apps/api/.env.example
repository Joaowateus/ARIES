# Copie este arquivo para .env e preencha os valores

# Banco de dados PostgreSQL
# Local: postgresql://aries:aries2026dev@localhost:5432/aries
# Neon:  postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/aries?sslmode=require
# Supabase: postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
DATABASE_URL="postgresql://..."

# Segredo JWT — use uma string longa e aleatória em produção
JWT_SECRET="mude-para-um-segredo-longo-e-aleatorio"

PORT=3001
NODE_ENV=production
FRONTEND_URL=https://seu-dominio.com.br

# Integração Social Media (Instagram via Meta Graph API) — opcional: sem
# essas três variáveis, a aba Social Media só oferece o caminho manual
# (colar um token do Graph API Explorer). Pra habilitar o login com um
# clique ("Conectar com Instagram"), crie um app em
# https://developers.facebook.com/apps (tipo "Empresa"), adicione o produto
# "Facebook Login" e copie o "ID do aplicativo"/"Chave secreta do aplicativo"
# em Configurações > Básico. Em Facebook Login > Configurações, cadastre
# ${FRONTEND_URL}/pro-labore/social-media/callback em "URIs de redirecionamento
# do OAuth válidos". As permissões instagram_basic/instagram_manage_insights/
# pages_show_list/pages_read_engagement pedem App Review da Meta antes de
# funcionar pra contas fora da lista de testadores do app.
META_APP_ID=""
META_APP_SECRET=""
# Também precisa ser definido no apps/web (NEXT_PUBLIC_META_APP_ID=<mesmo ID acima>)
# — é o valor usado pra montar a URL de autorização no navegador.

# Segredo compartilhado do cron externo que chama POST /social-media/sincronizar-cron
# periodicamente — gere uma string aleatória longa (ex.: openssl rand -hex 32).
SOCIAL_MEDIA_CRON_SECRET=""
