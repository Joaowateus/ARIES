# Copie este arquivo para .env e preencha os valores

# Banco de dados PostgreSQL
# Local: postgresql://aries:aries2026dev@localhost:5432/aries
# Neon:  postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/aries?sslmode=require
# Supabase: postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
DATABASE_URL="postgresql://..."

# Segredo JWT — use uma string longa e aleatória em produção
JWT_SECRET="mude-para-um-segredo-longo-e-aleatorio"

PORT=3001
NODE_ENV=production
FRONTEND_URL=https://seu-dominio.com.br

# Integração Social Media (Login do Instagram) — opcional: sem essas duas
# variáveis, a aba Social Media só oferece o caminho manual (colar um token
# gerado direto no painel da Meta). Pra habilitar o login com um clique
# ("Conectar com Instagram"), crie um app em https://developers.facebook.com/apps,
# adicione o caso de uso "Gerenciar mensagens e conteúdo no Instagram" e
# copie o "ID do app do Instagram"/"Chave secreta do app do Instagram" em
# Casos de uso > Personalizar > Configuração da API com login do Instagram
# (são credenciais diferentes do "ID do aplicativo" geral da Meta). Na
# mesma tela, em "4. Configurar o login da empresa no Instagram", cadastre
# ${FRONTEND_URL}/pro-labore/social-media/callback como URL de
# redirecionamento. Enquanto o app não passa pela revisão da Meta (App
# Review), a conta do Instagram usada precisa ser adicionada como
# "Testador do Instagram" em Funções do app > Funções, e o convite precisa
# ser aceito na própria conta em instagram.com/accounts/manage_access
# (aba "Convites do testador").
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
# Também precisa ser definido no apps/web (NEXT_PUBLIC_INSTAGRAM_APP_ID=<mesmo ID acima>)
# — é o valor usado pra montar a URL de autorização no navegador.

# Segredo compartilhado do cron externo que chama POST /social-media/sincronizar-cron
# periodicamente — gere uma string aleatória longa (ex.: openssl rand -hex 32).
SOCIAL_MEDIA_CRON_SECRET=""

# Assistente Comercial (WhatsApp por QR Code) — servidor Evolution API v2
# que mantém a sessão "aparelho conectado" de cada vendedor. Um servidor só
# atende todos os números. EVOLUTION_API_KEY é a AUTHENTICATION_API_KEY
# global configurada no próprio servidor. Sem essas variáveis a aba mostra
# só o simulador do roteiro.
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
# URL pública desta API (sem barra no final) — usada pra montar o endereço
# do webhook que o servidor do WhatsApp chama. Se ficar vazia, usa o host
# da própria requisição.
API_PUBLIC_URL=""
