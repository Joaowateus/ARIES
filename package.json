{
  "name": "aries-soe",
  "private": true,
  "version": "0.1.0",
  "description": "ARIES — Commercial OS (Sales Operating Engine)",
  "workspaces": [
    "packages/core/*",
    "packages/cap-01",
    "packages/cap-02"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "lint": "tsc --noEmit -p tsconfig.json",
    "clean": "find packages -name 'dist' -type d -exec rm -rf {} + 2>/dev/null; true"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
